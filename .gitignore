# Unreal. Anchored: UBT only ever creates these at the plugin root, and unanchored
# patterns would also match directories inside the CMake tree and fetched dependencies.
/Binaries/
/Intermediate/
/Saved/
/DerivedDataCache/
/Script/

# IDE
.idea/
.vs/
*.sln
*.vcxproj*
CMakeUserPresets.json
.cache/
compile_commands.json

# Native build tree
/build/
/out/

# Staged RmlUi, produced by scripts/build_ue_libs.ps1. Not committed: the static libraries
# run to tens of megabytes and would land in history again on every rebuild, and git-lfs has
# never been set up on this repo. Building them is a documented one-time step.
/Source/ThirdParty/RmlUiLibrary/lib/
/Source/ThirdParty/RmlUiLibrary/include/
/bin/

# uipreview outputs
/shots/
/reports/
/*.png
