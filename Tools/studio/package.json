{
	"name": "folio-studio",
	"version": "1.0.0",
	"private": true,
	"description": "WYSIWYG editor for Folio documents",
	"scripts": {
		"build:shell": "esbuild shell/main.ts shell/preload.ts --bundle --platform=node --format=cjs --external:electron --external:@lydell/node-pty --outdir=out/shell --log-level=warning",
		"build:app": "vite build --logLevel warn",
		"build": "npm run build:shell && npm run build:app",
		"start": "electron .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"parity": "electron parity/main.js"
	},
	"devDependencies": {
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"electron": "38.2.2",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	},
	"dependencies": {
		"@lydell/node-pty": "^1.2.0-beta.15",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"dockview-react": "^8.5.1",
		"markdown-it": "^15.0.2",
		"monaco-editor": "^0.57.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"main": "out/shell/main.js",
	"build": {
		"appId": "com.fogspire.folio.studio",
		"productName": "Folio Studio",
		"icon": "../../Resources/Icon512.png",
		"directories": {
			"output": "release"
		},
		"files": [
			"out/**",
			"engine/dist/**",
			"package.json"
		],
		"extraResources": [
			{
				"from": "../..",
				"to": "folio",
				"filter": [
					"rcss/**",
					"fonts/**",
					"examples/**",
					"docs/**",
					"Resources/**",
					"UI/**",
					"UI_CONVENTIONS.md",
					"LICENSE"
				]
			}
		],
		"mac": {
			"target": "dir",
			"identity": null
		},
		"win": {
			"target": "dir"
		},
		"linux": {
			"target": "dir"
		}
	}
}
