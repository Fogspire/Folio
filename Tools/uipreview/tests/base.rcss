/*
 * RmlUi has no user-agent stylesheet and defaults every element to display: inline, so a
 * base like this is mandatory rather than a convenience. Without it a document renders as
 * one run of overlapping inline text.
 *
 * This copy exists for the tool's own fixtures. The game's UI content owns the real one.
 */

body, div, p, h1, h2, h3, section, header, footer, nav, ul, li
{
	display: block;
}

em { font-style: italic; }
strong { font-weight: bold; }

table { box-sizing: border-box; display: table; }
tr    { box-sizing: border-box; display: table-row; }
td    { box-sizing: border-box; display: table-cell; }
