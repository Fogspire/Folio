<rml>
<head>
	<title>flipbook timing</title>
	<link type="text/rcss" href="/folio/folio.rcss"/>
	<style>
		/*
			One looping flipbook alone, for verify.py to read the frame sequence from filmstrip hashes:
			eight frames at 10 fps, so a 50ms filmstrip shows each frame twice and repeats every 16.
		*/
		body { background-color: #16161c; width: 100%; height: 100%; }
		flipbook { width: 64dp; height: 64dp; }
	</style>
</head>
<body>
	<flipbook src="/UI/art/flipbook_bars.png" columns="4" rows="2" fps="10"/>
</body>
</rml>
