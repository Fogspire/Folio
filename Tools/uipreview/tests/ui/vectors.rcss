/* BEGIN msdfbake vectors */
/* Generated by msdfbake vector. Edits between the markers are overwritten. */
@spritesheet vectors
{
	src: /ui/art/vectors.msdf.png;
	resolution: 1x;

	wide_0: 0px 0px 264px 104px;
	wide_1: 265px 0px 79px 79px;
	wide_2: 345px 0px 130px 53px;

	/* Each drawing's proportions. Nothing draws these; see below. */
	wide_frame: 0px 0px 512px 192px;
}

/* One stack box, a hidden frame image, then these in order:

     <div class="art-stack" style="width: 240dp">
       <img class="art-frame" sprite="art_frame"/>
       <img class="art_0-ink" sprite="art_0"/>
       <img class="art_1-ink" sprite="art_1"/>
     </div>

   The frame is what gives the box a height. Every layer is absolutely positioned,
   so on its own the box would collapse and nothing would render; RCSS has no
   aspect-ratio, and an image element's intrinsic size is the only thing that
   carries one. Set the width and let the frame find the height - setting both as
   percentages squashes the art, because the two resolve against different bases. */
.wide_0-ink { position: absolute; left: -1.3672%; top: -3.6458%; width: 102.7344%; height: 107.2917%; image-color: #3050a0; }
.wide_1-ink { position: absolute; left: 4.8828%; top: 9.6875%; width: 30.2344%; height: 80.6250%; image-color: #f0c674; }
.wide_2-ink { position: absolute; left: 43.6328%; top: 23.0208%; width: 50.2344%; height: 53.9583%; image-color: #c04030; }

.wide-stack { position: relative; display: block; }
.wide-frame { display: block; width: 100%; visibility: hidden; }
/* END msdfbake vectors */
