<rml>
<head>
	<title>CRT terminal</title>
	<link type="text/rcss" href="/folio/folio.rcss"/>
	<style>
		/* Written for an oval screen wider than it is tall. The document is still a rectangle - a render
		   target and a projection both are - and the corners simply are not on an oval mesh, so nothing
		   may be laid out there. RCSS border-radius takes no percentage, so the ellipse is a radial
		   falloff rather than a clip: it reads as glass on the mesh and as an oval on a flat surface.

		   Content sits inside the ellipse's inscribed rectangle, which is 1/sqrt(2) of each axis. Rows are
		   given their own widths rather than one column width, so the lines nearest the top and bottom
		   stay clear of the curve instead of running into it. */
		body {
			font-family: Roboto Mono;
			font-size: 32dp;
			color: #7dff9b;
			background-color: transparent;
			width: 100%;
			height: 100%;
			box-sizing: border-box;
			position: relative;
			overflow: hidden;
		}

		.glass {
			position: absolute;
			left: 0; top: 0;
			width: 100%; height: 100%;
			background-color: #04120a;
			overflow: hidden;
		}

		.screen {
			position: absolute;
			left: 15%; top: 15%;
			width: 70%; height: 70%;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
		}

		/* Every row is centred and capped, so the block is a lens shape rather than a rectangle. */
		.narrow { width: 62%; }
		.mid { width: 84%; }
		.wide { width: 100%; }

		.title { font-weight: bold; letter-spacing: 4dp; text-align: center;
		         font-effect: glow(3dp #2bff7a80); }
		.rule { height: 3dp; background-color: #7dff9b59; margin: 12dp 0; }
		.dim { color: #7dff9b8c; font-size: 24dp; }
		.centre { text-align: center; }

		.row { display: flex; align-items: center; margin-bottom: 14dp; }
		.label { width: 190dp; flex: 0 0 auto; }

		/* A field is a normal RmlUi text input. Caret, selection and editing all come from RmlUi;
		   nothing here is world-space specific. */
		input.field {
			flex: 1;
			height: 50dp;
			padding: 0 12dp;
			background-color: #7dff9b14;
			border: 2dp #7dff9b73;
			color: #b9ffcb;
			caret-color: #b9ffcb;
			tab-index: auto;
		}
		input.field:hover { border-color: #b9ffcb; background-color: #7dff9b26; }
		input.field:focus { border-color: #eaffef; background-color: #7dff9b33; }
		input.field selection { background-color: #7dff9b59; color: #04120a; }

		button {
			padding: 10dp 24dp;
			background-color: transparent;
			border: 2dp #7dff9b8c;
			color: #7dff9b;
			tab-index: auto;
		}
		button:hover { background-color: #7dff9b26; border-color: #b9ffcb; color: #eaffef; }
		button:active { background-color: #b9ffcb; color: #04120a; }
		button:focus { border-color: #eaffef; }

		/* Radios as channel buttons: pressing one visibly moves the selection with no script involved. */
		.buttons { display: flex; justify-content: center; }
		.buttons > * { margin: 0 8dp; }

		.channel { position: relative; }
		.channel input {
			position: absolute; left: 0; top: 0; width: 100%; height: 100%;
			opacity: 0; tab-index: auto;
		}
		.channel span {
			display: block;
			padding: 8dp 20dp;
			border: 2dp #7dff9b59;
			color: #7dff9b8c;
		}
		.channel input:hover ~ span { border-color: #b9ffcb; color: #eaffef; }
		.channel input:checked ~ span { background-color: #7dff9b33; border-color: #b9ffcb; color: #eaffef; }

		/* Cursor block, so the screen looks alive while nothing is being typed. */
		@keyframes blink { from { opacity: 1; } to { opacity: 0; } }
		.caret {
			display: inline-block;
			width: 16dp; height: 24dp;
			background-color: #7dff9b;
			animation: 0.6s blink infinite alternate;
		}

		/* Phosphor lines. A gradient rather than a scanline bitmap: it stays correct at whatever
		   resolution the surface renders at, which a fixed texture does not. */
		/* Overlays, so they must not take the pointer: they cover the whole screen and are drawn after
		   the content, so without this they swallow every hover and click meant for what is under them. */
		.scanlines, .vignette, .roll { pointer-events: none; }

		.scanlines {
			position: absolute; left: 0; top: 0; width: 100%; height: 100%;
			decorator: repeating-linear-gradient(to bottom,
				#00000000 0dp, #00000000 3dp, #00000047 3dp, #00000047 6dp);
		}

		/* Falloff towards the glass edge, which is what sells the curve of a tube. */
		.vignette {
			position: absolute; left: 0; top: 0; width: 100%; height: 100%;
			decorator: radial-gradient(ellipse farthest-side, #00000000 60%, #00000073 86%, #000000d9 100%);
		}


		/* A popped-up window, moved by its title bar and resized from its corner. Both are <handle>,
		   which is RmlUi's own element: move_target and size_target name what it acts on, so neither
		   needs a line of code. The window is absolutely positioned because a handle writes left, top,
		   width and height, and those mean nothing to a flex item. */
		.window {
			position: absolute;
			left: 40%; top: 20%;
			width: 42%; height: 30%;
			min-width: 260dp; min-height: 200dp;
			background-color: #04180cf7;
			border: 2dp #7dff9b8c;
			display: flex;
			flex-direction: column;
			z-index: 10;
		}
		.titlebar {
			display: block;
			padding: 8dp 12dp;
			background-color: #7dff9b26;
			border-bottom: 2dp #7dff9b59;
			font-size: 24dp;
			cursor: move;
		}
		.window-body { flex: 1; padding: 14dp; display: flex; }
		/* Big enough to hit from across a room. A 26dp corner is fine on a monitor and useless on a
		   screen you are aiming a camera at. */
		.grip {
			position: absolute;
			right: 0; bottom: 0;
			width: 60dp; height: 60dp;
			decorator: linear-gradient(135deg, #7dff9b00, #7dff9b00 54%, #7dff9b8c 54%, #7dff9b8c);
			cursor: se-resize;
		}
		.grip:hover { decorator: linear-gradient(135deg, #7dff9b00, #7dff9b00 54%, #eaffef 54%, #eaffef); }

		.close {
			position: absolute;
			right: 0; top: 0;
			width: 44dp; height: 44dp;
			line-height: 44dp;
			text-align: center;
			font-size: 26dp;
			color: #b9ffcb;
			tab-index: auto;
		}
		.close:hover { background-color: #ff5c5c; color: #04120a; }

		/* An icon dropped on the bin shrinks into it and is then removed outright. The drop leaves it
		   sitting over the bin already, so shrinking in place is what reads as being swallowed. */
		@keyframes consume {
			from { transform: scale(1.0); opacity: 1; }
			to   { transform: scale(0.05); opacity: 0; }
		}
		.desk-icon.folio-closing { animation: 0.35s cubic-in consume; }

		/* The way out, which folio-close waits for before hiding anything. Shrunk towards the bottom of
		   the screen rather than off it: on a surface the render target *is* the document, so anything
		   translated past its edge is clipped, and text that leaves the context is culled outright.
		   Both read as the window vanishing partway rather than travelling. */
		@keyframes suck {
			from { transform: translateY(0dp) scale(1.0); opacity: 1; }
			to   { transform: translateY(150dp) scale(0.06); opacity: 0; }
		}
		.window.folio-closing { animation: 0.5s cubic-in suck; }

		/* drag: drag makes an element draggable at all. Without it a press is a press and nothing
		   follows the pointer. */
		/* drag-drop rather than drag: only drag-drop and clone make RmlUi report a drop target at all,
		   so with plain drag the bin would never hear about it. folio-drag="move" is what actually
		   repositions the icon - RmlUi fires the events and moves nothing by itself. */
		.desk-icon {
			position: absolute;
			width: 112dp;
			drag: drag-drop;
			text-align: center;
			font-size: 20dp;
			color: #b9ffcb;
		}
		.desk-icon .glyph {
			display: block;
			height: 64dp;
			margin-bottom: 4dp;
			border: 2dp #7dff9b73;
			background-color: #7dff9b1f;
		}
		.desk-icon:hover .glyph { border-color: #eaffef; background-color: #7dff9b3d; }

		/* Set on whatever is being dragged, for as long as the drag lasts. */
		.desk-icon.folio-dragging { opacity: 0.55; }

		.bin {
			position: absolute;
			left: 19%; top: 56%;
			width: 110dp;
			text-align: center;
			font-size: 20dp;
			color: #7dff9b8c;
		}
		.bin .glyph {
			display: block;
			height: 76dp;
			margin-bottom: 4dp;
			border: 2dp #7dff9b73;
		}
		/* Set on a drop zone while a drag is over it, which is the whole of the feedback a bin needs. */
		.bin.folio-dragover { color: #eaffef; }
		.bin.folio-dragover .glyph { border-color: #eaffef; background-color: #7dff9b3d; }

		.roll {
			position: absolute; left: 0; width: 100%; height: 90dp;
			decorator: linear-gradient(to bottom, #7dff9b00, #7dff9b1f, #7dff9b00);
			animation: 5s roll infinite;
		}
		@keyframes roll {
			from { top: -90dp; }
			to   { top: 100%; }
		}
	</style>
</head>
<body>
	<div class="glass">
		<div class="screen">
			<div class="narrow title">SYS-7 TERMINAL</div>
			<div class="narrow centre dim">bay 4 · local link established</div>
			<div class="mid rule"></div>

			<div class="wide row">
				<span class="label">OPERATOR</span>
				<input type="text" class="field" id="operator" maxlength="24"/>
			</div>
			<div class="wide row">
				<span class="label">ACCESS</span>
				<input type="password" class="field" id="access" maxlength="16"/>
			</div>

			<div class="wide row buttons">
				<div class="channel">
					<input type="radio" name="channel" id="ch_a" checked/>
					<span>ALPHA</span>
				</div>
				<div class="channel">
					<input type="radio" name="channel" id="ch_b"/>
					<span>BETA</span>
				</div>
				<div class="channel">
					<input type="radio" name="channel" id="ch_c"/>
					<span>GAMMA</span>
				</div>
			</div>

			<div class="mid row buttons">
				<button id="engage">ENGAGE</button>
				<button id="purge">PURGE</button>
			</div>

			<div class="mid rule"></div>
			<div class="narrow centre dim">ready<span class="caret"></span></div>
		</div>


		<!-- Moved and resized with no code: the title bar is a handle whose move_target is the window,
		     and the corner grip is a handle whose size_target is the same window. -->
		<div id="win" class="window">
			<handle class="titlebar" move_target="win">DISK UTILITY</handle>
			<div class="close" folio-close="win">X</div>
			<div class="window-body">
				<div id="icon_a" class="desk-icon" folio-drag="move" style="left: 28dp; top: 66dp;">
					<span class="glyph"></span>CORE.DAT
				</div>
				<div id="icon_b" class="desk-icon" folio-drag="move" style="left: 168dp; top: 66dp;">
					<span class="glyph"></span>LOG.TXT
				</div>
			</div>
			<handle class="grip" size_target="win"></handle>
		</div>

		<!-- folio-drop is Folio's: hide the dropped element, remove it, or accept it and do the rest
		     yourself in a dragdrop listener. -->
		<div class="bin" folio-drop="remove">
			<span class="glyph"></span>RECYCLE
		</div>

		<div class="scanlines"></div>
		<div class="vignette"></div>
		<div class="roll"></div>
	</div>
</body>
</rml>
