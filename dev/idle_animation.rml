<rml>
<head>
	<title>Folio animation idle check</title>
	<link type="text/rcss" href="/folio/folio.rcss"/>
	<link type="text/rcss" href="/ui/vectors.rcss"/>
	<style>
		/* The document is wider than the pink panel on purpose. RmlUi culls a text line whose box does
		   not intersect the context, so anything meant to sit clear of the panel still has to be inside
		   the document: the strip above the panel is what gives the banner somewhere to be. */
		body { font-family: Inter; font-style: normal; font-weight: bold; font-size: 96dp;
		       color: #ffffff; width: 100%; height: 100%; box-sizing: border-box;
		       display: flex; flex-direction: column; }

		.banner { height: 104dp; text-align: center; font-size: 90dp;
		          font-effect: outline(4dp #3a1030); }

		.panel { flex: 1; position: relative; background-color: #f7c8d8; padding: 16dp;
		         box-sizing: border-box;
		         display: flex; flex-direction: column; align-items: center; justify-content: center; }

		@keyframes pulse {
			from { opacity: 0.5; }
			to   { opacity: 1.0; }
		}
		.pulsing { animation: 1.4s pulse infinite alternate; background-color: #ff7a18;
		           width: 180dp; height: 32dp; border-radius: 3dp; }

		/* A field holds one silhouette, so each fill and each stroke is its own sprite, tinted and stacked
		   by the classes msdfbake wrote into vectors.rcss. Only the width is set here: the hidden frame
		   image carries the proportions and finds the height, since every layer is absolutely positioned
		   and would otherwise leave the box with nothing to measure. */
		.mark { width: 320dp; margin-top: 12dp; }

		/* Half off each edge of the panel, so the panel's own bounds are visible in what is drawn
		   past them. */
		.corner { position: absolute; white-space: nowrap; }
		.tl { left: -260dp;  top: -58dp; }
		.tr { right: -260dp; top: -58dp; }
		.bl { left: -260dp;  bottom: -58dp; }
		.br { right: -260dp; bottom: -58dp; }

		/* Both widths count against the field's range, so this is close to as far as a glow reaches
		   before it saturates and stops growing. */
		.glowing { font-effect: glow(8dp 8dp 0dp 0dp #00e5ff); }
		.shadowed { font-effect: shadow(16dp 16dp #201028c0); }

		.crt-text { font-effect: fill-image("/folio/dev/crt_scanlines.png" 10dp); }
		/* font-effect is not animatable, so the pattern is static and the roll is a separate band. */
		.crt-roll { position: absolute; left: 0; width: 100%; height: 28dp;
		            decorator: linear-gradient(to bottom, #ffffff00, #ffffff59, #ffffff00);
		            animation: 2.5s roll infinite; }
		@keyframes roll {
			from { top: -28dp; }
			to   { top: 116dp; }
		}
	</style>
</head>
<body>
	<div class="banner">Folio Custom Rendering</div>

	<!-- Nothing else moves, so whatever the invalidation trace reports is the animation's own request.
	     RmlUi asks for a delay of 0 while any element is animating, which is what must keep this
	     document out of the idle path. -->
	<div class="panel">
		<div class="pulsing"></div>
		<div class="mark Demo-stack">
			<img class="Demo-frame" sprite="Demo_frame"/>
			<img class="Demo_0-ink" sprite="Demo_0"/>
			<img class="Demo_1-ink" sprite="Demo_1"/>
			<img class="Demo_2-ink" sprite="Demo_2"/>
			<img class="Demo_3-ink" sprite="Demo_3"/>
		</div>

		<div class="corner tl">Text Block</div>
		<div class="corner br glowing">Text Block</div>
		<div class="corner bl shadowed">Text Block</div>
		<div class="corner tr">
			<div class="crt-text">Text Block</div>
			<div class="crt-roll"></div>
		</div>
	</div>
</body>
</rml>
