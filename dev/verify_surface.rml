<rml>
<head>
	<title>Surface verification</title>
	<link type="text/rcss" href="/folio/folio.rcss"/>
	<style>
		/*
		 * Everything here exists to be measured rather than looked at.
		 *
		 * A gradient is the interesting case: it is the one decorator drawn through RenderShader rather
		 * than RenderGeometry, so it has its own way into a layer and can be missing from a surface
		 * while everything else is present. A gradient also *varies* by definition, which is what makes
		 * it checkable - a surface that renders it as one flat colour has failed even if it drew.
		 */
		body { width: 100%; height: 100%; background-color: #101018; }

		.strip { width: 100%; height: 33%; }

		.linear { decorator: linear-gradient(to right, #ff0000, #0000ff); }
		.radial { decorator: radial-gradient(circle farthest-side, #00ff00, #101018); }
		.solid  { background-color: #808080; }
	</style>
</head>
<body>
	<div class="strip linear"></div>
	<div class="strip radial"></div>
	<div class="strip solid"></div>
</body>
</rml>
