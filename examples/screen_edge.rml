<rml>
<head>
	<title>Screen edge effects</title>
	<link type="text/rcss" href="/folio/folio.rcss"/>
	<style>
		/* The same four washes as `screen_edge_baker.rml`, drawn from the textures that document
		   produced. Identical on screen; one quad each instead of a full-screen render target each,
		   every frame, forever.

		   Bake them again after changing the baker:

		     uipreview examples/screen_edge_baker.rml --root . --size 1920x1080 --dp-ratio 1 \
		       --bake "#base=examples/art/edge_base.png" \
		       --bake "#burning=examples/art/edge_burning.png" \
		       --bake "#frozen=examples/art/edge_frozen.png" \
		       --bake "#hit=examples/art/edge_hit.png"

		   Everything a state or an event does still happens here, because none of it was ever the
		   shadow: opacity is what fades, cross-fades and flashes, and opacity is free. */
		body {
			/* Positioned, or every .edge below resolves against the initial containing block instead. */
			position: relative;
			width: 100%;
			height: 100%;
			background-color: #56603f;
			font-family: Roboto Mono;
		}

		/*
		 * Every layer is the same box: the whole view, drawn behind the readouts, unable to take
		 * focus or a click. Only the texture and the opacity differ.
		 *
		 * No `border-radius` and no `box-shadow`. The rounded corners are in the art, which is what
		 * a baked effect means - the shape stops being something the renderer works out per frame.
		 */
		.edge {
			position: absolute;
			left: 0dp;
			top: 0dp;
			width: 100%;
			height: 100%;
			z-index: -1;
			opacity: 0;
			pointer-events: none;
			focus: none;
		}

		/* Always on, and the reason the corners read as corners rather than as a state. */
		#base {
			decorator: image(/folio/examples/art/edge_base.png fill);
			opacity: 1;
		}

		/* A state. Cross-faded, which is what it always was: the shadow never interpolated either. */
		#burning { decorator: image(/folio/examples/art/edge_burning.png fill); transition: opacity 0.45s cubic-out; }
		#frozen  { decorator: image(/folio/examples/art/edge_frozen.png fill); transition: opacity 0.45s cubic-out; }

		body.burning #burning { opacity: 1; animation: 1.1s sine-in-out infinite breathe; }
		body.frozen  #frozen  { opacity: 1; }

		@keyframes breathe { from { opacity: 0.55; } 50% { opacity: 1; } to { opacity: 0.55; } }

		/* An event. Reaches further in than any state layer, so a hit reads over a standing effect. */
		#hit { decorator: image(/folio/examples/art/edge_hit.png fill); }

		body.hit-a #hit { animation: 0.42s cubic-out hit-a; }
		body.hit-b #hit { animation: 0.42s cubic-out hit-b; }

		/* Declared twice with the same body: RCSS restarts an animation only when the property changes. */
		@keyframes hit-a { from { opacity: 0; } 12% { opacity: 0.75; } to { opacity: 0; } }
		@keyframes hit-b { from { opacity: 0; } 12% { opacity: 0.75; } to { opacity: 0; } }

		.note {
			position: absolute;
			left: 90dp;
			bottom: 80dp;
			font-size: 20dp;
			color: #f0e7d6;
			font-effect: shadow(2dp 2dp #0a0812);
		}
	</style>
</head>
<body class="burning hit-a">
	<!-- Every layer is marked, so a player who has turned screen effects off loses the lot: a wash
	     over the HUD, a breathing overlay and a hit flash are three different problems and whoever
	     needs one gone needs all three gone. -->
	<div id="base" class="edge" folio-screen-effect/>
	<div id="burning" class="edge" folio-screen-effect/>
	<div id="frozen" class="edge" folio-screen-effect/>
	<div id="hit" class="edge" folio-screen-effect/>

	<div class="note">standing in fire, taking a hit</div>
</body>
</rml>
