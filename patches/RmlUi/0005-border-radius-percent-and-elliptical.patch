+/// Parses 'border-radius': one to four horizontal radii, then optionally '/' and one to four vertical radii. Without
+/// the slash the vertical radii are the horizontal ones, so every corner is a circle.
+static bool ParseBorderRadiusShorthand(PropertyDictionary& dictionary, const ShorthandDefinition& definition, const StringList& values)
+{
+	RMLUI_ASSERT(definition.items.size() == 8);
+
+	const auto slash = std::find(values.begin(), values.end(), "/");
+	const StringList horizontal(values.begin(), slash);
+	const StringList vertical = (slash == values.end() ? horizontal : StringList(slash + 1, values.end()));
+
+	if (horizontal.empty() || horizontal.size() > 4 || vertical.empty() || vertical.size() > 4 ||
+		(slash != values.end() && std::find(slash + 1, values.end(), "/") != values.end()))
+		return false;
+
+	// Which value each corner takes, ordered top-left, top-right, bottom-right, bottom-left, by the number declared.
+	static const int corner_to_value_index[4][4] = {{0, 0, 0, 0}, {0, 1, 0, 1}, {0, 1, 2, 1}, {0, 1, 2, 3}};
+
+	Property properties[8];
+	for (int corner = 0; corner < 4; corner++)
+	{
+		const String& x = horizontal[corner_to_value_index[horizontal.size() - 1][corner]];
+		const String& y = vertical[corner_to_value_index[vertical.size() - 1][corner]];
+
+		if (!definition.items[corner].property_definition->ParseValue(properties[corner], x) ||
+			!definition.items[4 + corner].property_definition->ParseValue(properties[4 + corner], y))
+			return false;
+	}
+
+	for (int i = 0; i < 8; i++)
+		dictionary.SetProperty(definition.items[i].property_id, properties[i]);
+
+	return true;
+}
