+		/// Returns the radii of each corner, resolving percentages against the given border box size.
+		CornerSizes2 border_radius(Vector2f border_size) const
+		{
+			CornerSizes2 result;
+			for (int corner = 0; corner < 4; corner++)
+				result[corner] = {ResolveBorderRadius(corner, border_size.x), ResolveBorderRadius(4 + corner, border_size.y)};
+			return result;
+		}
+
 	private:
+		LengthPercentage GetBorderRadius(int index) const
+		{
+			const bool percentage = (rare.border_radius_percentage & (1 << index)) != 0;
+			return LengthPercentage(percentage ? LengthPercentage::Percentage : LengthPercentage::Length, rare.border_radius[index]);
+		}
+		void SetBorderRadius(int index, LengthPercentage value)
+		{
+			const uint8_t bit = uint8_t(1 << index);
+			rare.border_radius[index] = (value.value > 0.f ? value.value : 0.f);
+			if (value.type == LengthPercentage::Percentage)
+				rare.border_radius_percentage |= bit;
+			else
+				rare.border_radius_percentage &= uint8_t(~bit);
+		}
+		float ResolveBorderRadius(int index, float base) const
+		{
+			const bool percentage = (rare.border_radius_percentage & (1 << index)) != 0;
+			return percentage ? rare.border_radius[index] * base * 0.01f : rare.border_radius[index];
+		}
+
