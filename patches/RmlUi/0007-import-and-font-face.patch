+/*
+ * Font faces take descriptors rather than properties, and only four of them.
+ */
+class FontFacePropertyParser final : public AbstractPropertyParser {
+public:
+	String family;
+	String src;
+	Style::FontStyle style = Style::FontStyle::Normal;
+	Style::FontWeight weight = Style::FontWeight::Normal;
+
+	void Clear()
+	{
+		family.clear();
+		src.clear();
+		style = Style::FontStyle::Normal;
+		weight = Style::FontWeight::Normal;
+	}
+
+	bool Parse(const String& name, const String& value) override
+	{
+		if (name == "font-family")
+		{
+			family = StripQuotes(value);
+			return !family.empty();
+		}
+		if (name == "src")
+		{
+			src = ParseUrl(value);
+			return !src.empty();
+		}
+		if (name == "font-style")
+		{
+			if (value == "normal")
+				style = Style::FontStyle::Normal;
+			else if (value == "italic" || value == "oblique")
+				style = Style::FontStyle::Italic;
+			else
+				return false;
+			return true;
+		}
+		if (name == "font-weight")
+		{
+			StringList values;
+			StringUtilities::ExpandString(values, value, ' ');
+			if (values.size() == 2)
+			{
+				// A range, which is a variable face covering every weight in it.
+				weight = Style::FontWeight::Auto;
+				return true;
+			}
+			if (value == "normal")
+				weight = Style::FontWeight::Normal;
+			else if (value == "bold")
+				weight = Style::FontWeight::Bold;
+			else
+			{
+				const int number = std::atoi(value.c_str());
+				if (number < 1 || number > 1000)
+					return false;
+				weight = Style::FontWeight(number);
+			}
+			return true;
+		}
+		return false;
+	}
+
+	static String StripQuotes(const String& value)
+	{
+		if (value.size() >= 2 && (value.front() == '"' || value.front() == '\'') && value.back() == value.front())
+			return value.substr(1, value.size() - 2);
+		return value;
+	}
+
+	// The first of `url(path)`, `url("path")` or `"path"`, ignoring any format() hint or later fallback.
+	static String ParseUrl(const String& value)
+	{
+		String first = StringUtilities::StripWhitespace(value.substr(0, value.find(',')));
+		if (first.compare(0, 4, "url(") == 0)
+		{
+			const size_t close = first.find(')');
+			if (close == String::npos)
+				return String();
+			first = StringUtilities::StripWhitespace(first.substr(4, close - 4));
+		}
+		else
+		{
+			first = first.substr(0, first.find(' '));
+		}
+		return StripQuotes(first);
+	}
+};
