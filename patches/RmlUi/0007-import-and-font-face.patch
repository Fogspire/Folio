+void StyleSheetParser::ImportStyleSheet(MediaBlockList& style_sheets, const String& import_rule)
+{
+	const String source_url = StringUtilities::Replace(stream->GetSourceURL().GetURL(), '|', ':');
+	const String path = FontFacePropertyParser::ParseUrl(StringUtilities::StripWhitespace(import_rule));
+	if (path.empty())
+	{
+		Log::Message(Log::LT_WARNING, "@import names no stylesheet at %s:%d", stream_file_name.c_str(), line_number);
+		return;
+	}
+
+	String joined_path;
+	GetSystemInterface()->JoinPath(joined_path, source_url, path);
+
+	Vector<String> chain = import_chain;
+	chain.push_back(source_url);
+	if (std::find(chain.begin(), chain.end(), joined_path) != chain.end() || (int)chain.size() > max_import_depth)
+	{
+		Log::Message(Log::LT_WARNING, "@import of '%s' imports itself, ignored. At %s:%d", path.c_str(), stream_file_name.c_str(), line_number);
+		return;
+	}
+
+	// Probed first, since StreamFile reports a missing file without saying what referred to it.
+	FileInterface* file_interface = GetFileInterface();
+	const FileHandle probe = file_interface->Open(joined_path);
+	if (!probe)
+	{
+		Log::Message(Log::LT_WARNING, "@import of '%s' could not be opened at %s:%d", path.c_str(), stream_file_name.c_str(), line_number);
+		return;
+	}
+	file_interface->Close(probe);
+
+	StreamFile file;
+	if (!file.Open(joined_path))
+		return;
+
+	StyleSheetParser imported;
+	imported.import_chain = std::move(chain);
+	imported.Parse(style_sheets, &file, 1);
+}
+
+void StyleSheetParser::LoadFontFace(const String& family, const String& src, Style::FontStyle style, Style::FontWeight weight)
+{
+	if (family.empty() || src.empty())
+	{
+		Log::Message(Log::LT_WARNING, "@font-face needs both font-family and src, ignored. At %s:%d", stream_file_name.c_str(), line_number);
+		return;
+	}
+
+	String path;
+	GetSystemInterface()->JoinPath(path, StringUtilities::Replace(stream->GetSourceURL().GetURL(), '|', ':'), src);
+
+	const String key = StringUtilities::ToLower(family) + '|' + ToString((int)style) + '|' + ToString((int)weight);
+	auto& loaded = GetLoadedFontFaces();
+	auto it = loaded.find(key);
+	if (it != loaded.end())
+	{
+		if (it->second.path != path)
+		{
+			Log::Message(Log::LT_WARNING,
+				"@font-face '%s' is already loaded from '%s', so '%s' is ignored. Font faces are global, not per document. At %s:%d",
+				family.c_str(), it->second.path.c_str(), path.c_str(), stream_file_name.c_str(), line_number);
+		}
+		return;
+	}
+
+	FileInterface* file_interface = GetFileInterface();
+	const FileHandle handle = file_interface->Open(path);
+	if (!handle)
+	{
+		Log::Message(Log::LT_WARNING, "@font-face '%s' could not open '%s' at %s:%d", family.c_str(), path.c_str(), stream_file_name.c_str(),
+			line_number);
+		return;
+	}
+
+	LoadedFontFace face;
+	face.path = path;
+	face.data.resize(file_interface->Length(handle));
+	const size_t read = file_interface->Read(face.data.data(), face.data.size(), handle);
+	file_interface->Close(handle);
+
+	if (face.data.empty() || read != face.data.size() || !Rml::LoadFontFace(face.data, family, style, weight))
+	{
+		Log::Message(Log::LT_WARNING, "@font-face '%s' could not load '%s' at %s:%d", family.c_str(), path.c_str(), stream_file_name.c_str(),
+			line_number);
+		return;
+	}
+
+	loaded.emplace(key, std::move(face));
+}
