diff --git a/Source/Core/Calc.cpp b/Source/Core/Calc.cpp
new file mode 100644
index 0000000..5e5e9a0
--- /dev/null
+++ b/Source/Core/Calc.cpp
@@ -0,0 +1,373 @@
+#include "Calc.h"
+#include "../../Include/RmlUi/Core/Log.h"
+#include "../../Include/RmlUi/Core/Property.h"
+#include "../../Include/RmlUi/Core/StringUtilities.h"
+#include "ComputeProperty.h"
+#include <cstring>
+#include <stdlib.h>
+
+namespace Rml {
+namespace Calc {
+
+	namespace {
+
+		struct UnitName {
+			const char* name;
+			Unit unit;
+		};
+
+		// Longest suffix first, so "rem" is not read as "em".
+		const UnitName unit_names[] = {
+			{"rem", Unit::REM},
+			{"px", Unit::PX},
+			{"dp", Unit::DP},
+			{"vw", Unit::VW},
+			{"vh", Unit::VH},
+			{"em", Unit::EM},
+			{"in", Unit::INCH},
+			{"cm", Unit::CM},
+			{"mm", Unit::MM},
+			{"pt", Unit::PT},
+			{"pc", Unit::PC},
+			{"%", Unit::PERCENT},
+		};
+
+		// One slot per unit a term can carry. NUMBER is a plain factor, and must cancel out of a length.
+		const Unit term_units[] = {Unit::NUMBER, Unit::PERCENT, Unit::PX, Unit::DP, Unit::VW, Unit::VH, Unit::EM, Unit::REM, Unit::INCH,
+			Unit::CM, Unit::MM, Unit::PT, Unit::PC};
+		constexpr int NumTermUnits = int(sizeof(term_units) / sizeof(term_units[0]));
+
+		struct Expression {
+			float coefficients[NumTermUnits] = {};
+
+			bool IsNumber() const
+			{
+				for (int i = 1; i < NumTermUnits; i++)
+					if (coefficients[i] != 0.f)
+						return false;
+				return true;
+			}
+			bool operator==(const Expression& other) const { return std::memcmp(coefficients, other.coefficients, sizeof(coefficients)) == 0; }
+		};
+
+		struct Registry {
+			Vector<Expression> expressions;
+			Vector<Resolved> resolved;
+		};
+
+		Registry& GetRegistry()
+		{
+			static Registry registry;
+			return registry;
+		}
+
+		char Lower(char c) { return c >= 'A' && c <= 'Z' ? char(c - 'A' + 'a') : c; }
+
+		int SlotOf(Unit unit)
+		{
+			for (int i = 0; i < NumTermUnits; i++)
+				if (term_units[i] == unit)
+					return i;
+			return -1;
+		}
+
+		class Parser {
+		public:
+			explicit Parser(const String& in_text) : text(in_text) {}
+
+			bool Parse(Expression& out)
+			{
+				if (!ParseSum(out))
+					return false;
+				SkipSpace();
+				return position == text.size();
+			}
+
+		private:
+			const String& text;
+			size_t position = 0;
+
+			void SkipSpace()
+			{
+				while (position < text.size() && StringUtilities::IsWhitespace(text[position]))
+					position++;
+			}
+
+			bool Consume(char c)
+			{
+				SkipSpace();
+				if (position < text.size() && text[position] == c)
+				{
+					position++;
+					return true;
+				}
+				return false;
+			}
+
+			bool ConsumeWord(const char* word)
+			{
+				SkipSpace();
+				const size_t length = std::strlen(word);
+				if (text.size() - position < length)
+					return false;
+				for (size_t i = 0; i < length; i++)
+					if (Lower(text[position + i]) != word[i])
+						return false;
+				position += length;
+				return true;
+			}
+
+			bool ParseSum(Expression& out)
+			{
+				if (!ParseProduct(out))
+					return false;
+				for (;;)
+				{
+					SkipSpace();
+					if (position >= text.size() || (text[position] != '+' && text[position] != '-'))
+						return true;
+					const float sign = text[position] == '+' ? 1.f : -1.f;
+					position++;
+
+					Expression right;
+					if (!ParseProduct(right))
+						return false;
+					for (int i = 0; i < NumTermUnits; i++)
+						out.coefficients[i] += sign * right.coefficients[i];
+				}
+			}
+
+			bool ParseProduct(Expression& out)
+			{
+				if (!ParseFactor(out))
+					return false;
+				for (;;)
+				{
+					SkipSpace();
+					if (position >= text.size() || (text[position] != '*' && text[position] != '/'))
+						return true;
+					const bool divide = text[position] == '/';
+					position++;
+
+					Expression right;
+					if (!ParseFactor(right))
+						return false;
+
+					// One side of a product is a plain number, and only a plain number divides.
+					if (divide)
+					{
+						if (!right.IsNumber() || right.coefficients[0] == 0.f)
+							return false;
+						for (float& coefficient : out.coefficients)
+							coefficient /= right.coefficients[0];
+					}
+					else if (right.IsNumber())
+					{
+						for (float& coefficient : out.coefficients)
+							coefficient *= right.coefficients[0];
+					}
+					else if (out.IsNumber())
+					{
+						const float factor = out.coefficients[0];
+						out = right;
+						for (float& coefficient : out.coefficients)
+							coefficient *= factor;
+					}
+					else
+						return false;
+				}
+			}
+
+			bool ParseFactor(Expression& out)
+			{
+				SkipSpace();
+				if (position >= text.size())
+					return false;
+
+				if (text[position] == '-' || text[position] == '+')
+				{
+					const float sign = text[position] == '-' ? -1.f : 1.f;
+					position++;
+					if (!ParseFactor(out))
+						return false;
+					for (float& coefficient : out.coefficients)
+						coefficient *= sign;
+					return true;
+				}
+
+				if (ConsumeWord("calc("))
+				{
+					position--;
+				}
+
+				if (Consume('('))
+					return ParseSum(out) && Consume(')');
+
+				const char* start = text.c_str() + position;
+				char* end = nullptr;
+				const float number = strtof(start, &end);
+				if (end == start)
+					return false;
+				position += size_t(end - start);
+
+				Unit unit = Unit::NUMBER;
+				for (const UnitName& candidate : unit_names)
+				{
+					const size_t length = std::strlen(candidate.name);
+					if (text.size() - position >= length && StringUtilities::ToLower(text.substr(position, length)) == candidate.name)
+					{
+						// A unit is a whole word: "1em" yes, "1emx" no.
+						const size_t after = position + length;
+						const char next = after < text.size() ? text[after] : ' ';
+						if ((next >= 'a' && next <= 'z') || (next >= 'A' && next <= 'Z'))
+							continue;
+						unit = candidate.unit;
+						position = after;
+						break;
+					}
+				}
+
+				out = Expression();
+				out.coefficients[SlotOf(unit)] = number;
+				return true;
+			}
+		};
+
+		float Intern(const Expression& expression)
+		{
+			Vector<Expression>& expressions = GetRegistry().expressions;
+			for (size_t i = 0; i < expressions.size(); i++)
+				if (expressions[i] == expression)
+					return float(i);
+			expressions.push_back(expression);
+			return float(expressions.size() - 1);
+		}
+
+	} // namespace
+
+	bool IsCalc(const String& value)
+	{
+		size_t start = 0;
+		while (start < value.size() && StringUtilities::IsWhitespace(value[start]))
+			start++;
+		return value.size() - start >= 5 && StringUtilities::ToLower(value.substr(start, 5)) == "calc(";
+	}
+
+	bool Parse(Property& property, const String& value, Units allowed_units)
+	{
+		Expression expression;
+		Parser parser(value);
+		if (!parser.Parse(expression))
+			return false;
+
+		// A plain number left over is a unitless term added to a length, which has no meaning.
+		int used = 0;
+		int last = -1;
+		for (int i = 0; i < NumTermUnits; i++)
+		{
+			if (expression.coefficients[i] == 0.f)
+				continue;
+			if (!Any(term_units[i] & allowed_units))
+				return false;
+			used++;
+			last = i;
+		}
+
+		if (used <= 1)
+		{
+			// A single unit, or zero: an ordinary value, so it animates and resolves like any other.
+			const Unit unit = last < 0 ? Unit::PX : term_units[last];
+			if (last < 0 && !Any(allowed_units & Unit::PX))
+				return false;
+			property.value = last < 0 ? 0.f : expression.coefficients[last];
+			property.unit = unit;
+			return true;
+		}
+
+		if (expression.coefficients[0] != 0.f)
+			return false;
+
+		property.value = Intern(expression);
+		property.unit = Unit::CALC;
+		return true;
+	}
+
+	Resolved Resolve(float index, float font_size, float document_font_size, float dp_ratio, Vector2f vp_dimensions)
+	{
+		Resolved result;
+		const Vector<Expression>& expressions = GetRegistry().expressions;
+		const size_t i = size_t(index);
+		if (index < 0.f || i >= expressions.size())
+			return result;
+
+		const Expression& expression = expressions[i];
+		for (int slot = 0; slot < NumTermUnits; slot++)
+		{
+			const float coefficient = expression.coefficients[slot];
+			if (coefficient == 0.f)
+				continue;
+			if (term_units[slot] == Unit::PERCENT)
+				result.percent += coefficient;
+			else if (term_units[slot] != Unit::NUMBER)
+				result.pixels += ComputeLength(NumericValue(coefficient, term_units[slot]), font_size, document_font_size, dp_ratio, vp_dimensions);
+		}
+		return result;
+	}
+
+	float InternResolved(Resolved resolved)
+	{
+		Vector<Resolved>& list = GetRegistry().resolved;
+		for (size_t i = 0; i < list.size(); i++)
+			if (list[i].pixels == resolved.pixels && list[i].percent == resolved.percent)
+				return float(i);
+
+		// A value animated through calc would intern every frame's result. The table is small per document, so a
+		// large one means something is churning; it is cleared rather than left to grow without bound.
+		if (list.size() >= 1 << 16)
+		{
+			Log::Message(Log::LT_WARNING, "calc(): over 65536 distinct resolved values, the table was reset");
+			list.clear();
+		}
+		list.push_back(resolved);
+		return float(list.size() - 1);
+	}
+
+	Resolved GetResolved(float index)
+	{
+		const Vector<Resolved>& list = GetRegistry().resolved;
+		const size_t i = size_t(index);
+		return index >= 0.f && i < list.size() ? list[i] : Resolved();
+	}
+
+	String ToString(float index)
+	{
+		const Vector<Expression>& expressions = GetRegistry().expressions;
+		const size_t i = size_t(index);
+		if (index < 0.f || i >= expressions.size())
+			return "calc(0px)";
+
+		String result = "calc(";
+		bool first = true;
+		for (int slot = 1; slot < NumTermUnits; slot++)
+		{
+			const float coefficient = expressions[i].coefficients[slot];
+			if (coefficient == 0.f)
+				continue;
+
+			const char* name = "px";
+			for (const UnitName& candidate : unit_names)
+				if (candidate.unit == term_units[slot])
+					name = candidate.name;
+
+			if (!first)
+				result += coefficient < 0.f ? " - " : " + ";
+			else if (coefficient < 0.f)
+				result += "-";
+			result += CreateString("%g%s", coefficient < 0.f ? -coefficient : coefficient, name);
+			first = false;
+		}
+		return result + ")";
+	}
+
+} // namespace Calc
+} // namespace Rml
diff --git a/Source/Core/Calc.h b/Source/Core/Calc.h
new file mode 100644
index 0000000..6fce4f9
--- /dev/null
+++ b/Source/Core/Calc.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include "../../Include/RmlUi/Core/Types.h"
+#include "../../Include/RmlUi/Core/Unit.h"
+
+namespace Rml {
+
+class Property;
+
+/*
+    calc(): a sum of lengths and a percentage, such as calc(100% - 2 * 12dp).
+
+    Parsed into one coefficient per unit and interned, so a property holds only an index. Units other than the
+    percentage resolve when the element's values are computed; the percentage resolves at layout, against the
+    same base a plain percentage would.
+*/
+namespace Calc {
+
+	// Parses value as calc(...). Accepts only the units in allowed_units. A sum of a single unit comes back as that
+	// unit, so calc(2 * 8dp) is an ordinary 16dp.
+	bool Parse(Property& property, const String& value, Units allowed_units);
+
+	// Whether value starts with calc(, ignoring case and leading space.
+	bool IsCalc(const String& value);
+
+	// The pixels an expression stands for once its non-percentage units are resolved, and its percentage.
+	struct Resolved {
+		float pixels = 0.f;
+		float percent = 0.f;
+	};
+	Resolved Resolve(float index, float font_size, float document_font_size, float dp_ratio, Vector2f vp_dimensions);
+
+	// Interns a resolved percentage and offset for a computed value to carry, and reads one back.
+	float InternResolved(Resolved resolved);
+	Resolved GetResolved(float index);
+
+	// The expression as written back, for debugging and serialization.
+	String ToString(float index);
+
+} // namespace Calc
+} // namespace Rml
diff --git a/Source/Core/ComputeProperty.cpp b/Source/Core/ComputeProperty.cpp
index 2dff457..c591e32 100644
--- a/Source/Core/ComputeProperty.cpp
+++ b/Source/Core/ComputeProperty.cpp
@@ -1,5 +1,6 @@
 #include "ComputeProperty.h"
 #include "../../Include/RmlUi/Core/ComputedValues.h"
+#include "Calc.h"
 #include "../../Include/RmlUi/Core/Property.h"
 #include "../../Include/RmlUi/Core/StringUtilities.h"
 #include "ControlledLifetimeResource.h"
@@ -54,6 +55,10 @@ float ComputeLength(NumericValue value, float font_size, float document_font_siz
 	if (Any(value.unit & Unit::PPI_UNIT))
 		return ComputePPILength(value, dp_ratio);
 
+	// Where only a length makes sense, the percentage of a calc() has nothing to be a percentage of.
+	if (value.unit == Unit::CALC)
+		return Calc::Resolve(value.number, font_size, document_font_size, dp_ratio, vp_dimensions).pixels;
+
 	switch (value.unit)
