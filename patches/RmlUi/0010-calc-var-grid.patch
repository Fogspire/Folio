+#pragma once
+
+#include "../../../Include/RmlUi/Core/Types.h"
+#include "FormattingContext.h"
+
+namespace Rml {
+
+class LayoutBox;
+class ContainerBox;
+class FlexContainer;
+
+/*
+    Formats a grid container and its items.
+
+    Explicit tracks come from grid-template-columns and grid-template-rows, implicit ones from grid-auto-columns and
+    grid-auto-rows. Items are placed by grid-column and grid-row, and the rest flow into the next free cells along
+    grid-auto-flow. A subset of CSS grid: no named lines or areas, no dense packing, no subgrid.
+*/
+class GridFormattingContext final : public FormattingContext {
+public:
+	static UniquePtr<LayoutBox> Format(ContainerBox* parent_container, Element* element, const Box* override_initial_box);
+
+	static Vector2f GetMaxContentSize(Element* element);
+
+private:
+	GridFormattingContext() = default;
+
+	void Format(Vector2f& resulting_content_size, Vector2f& content_overflow_size, float& baseline) const;
+
+	// Negative means indefinite.
+	Vector2f available_content_size;
+	Vector2f content_containing_block;
+	Vector2f content_offset;
+
+	Element* element_grid = nullptr;
+	FlexContainer* container_box = nullptr;
+};
+
+} // namespace Rml
