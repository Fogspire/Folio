+// Where the next var( starts, or npos. A name such as myvar( is not one.
+static size_t FindVar(const String& text, size_t from)
+{
+	for (size_t i = from; i + 4 <= text.size(); i++)
+	{
+		if ((text[i] == 'v' || text[i] == 'V') && (text[i + 1] == 'a' || text[i + 1] == 'A') && (text[i + 2] == 'r' || text[i + 2] == 'R') &&
+			text[i + 3] == '(' && (i == 0 || !(std::isalnum((unsigned char)text[i - 1]) || text[i - 1] == '-')))
+			return i;
+	}
+	return String::npos;
+}
+
+// Replaces every var(--name, fallback) in input. Custom properties may use var() themselves, to a limited depth, so
+// one that refers back to itself fails instead of recursing forever.
+static bool SubstituteVars(const ElementStyle& style, const String& input, String& output, int depth)
+{
+	if (depth > 16)
+		return false;
+
+	output.clear();
+	size_t position = 0;
+	while (position < input.size())
+	{
+		const size_t start = FindVar(input, position);
+		if (start == String::npos)
+		{
+			output.append(input, position, String::npos);
+			break;
+		}
+		output.append(input, position, start - position);
+
+		const size_t open = start + 3;
+		size_t close = String::npos, comma = String::npos;
+		int level = 0;
+		for (size_t i = open; i < input.size(); i++)
+		{
+			const char c = input[i];
+			if (c == '(')
+				level++;
+			else if (c == ')' && --level == 0)
+			{
+				close = i;
+				break;
+			}
+			else if (c == ',' && level == 1 && comma == String::npos)
+				comma = i;
+		}
+		if (close == String::npos)
+			return false;
+
+		const String name = StringUtilities::StripWhitespace(input.substr(open + 1, (comma == String::npos ? close : comma) - open - 1));
+
+		String replacement;
+		const Property* custom = style.GetCustomProperty(name);
+		if (!custom || !SubstituteVars(style, custom->Get<String>(), replacement, depth + 1))
+		{
+			if (comma == String::npos || !SubstituteVars(style, input.substr(comma + 1, close - comma - 1), replacement, depth + 1))
+				return false;
+		}
+
+		output += StringUtilities::StripWhitespace(replacement);
+		position = close + 1;
+	}
