+	enum class TrackKind : uint8_t { Length, Fr, Auto };
+
+	struct TrackBound {
+		TrackKind kind = TrackKind::Auto;
+		NumericValue length; // Length: any length, percentage or calc()
+		float fr = 0.f;      // Fr
+	};
+
+	// A plain size is its own minimum and maximum. fr has a minimum of zero rather than CSS's content minimum, so
+	// equal fractions stay equal whatever is in them.
+	struct TrackSize {
+		TrackBound min, max;
+	};
+
+	struct Placement {
+		int start = 0; // Line, 1-based; negative counts back from the end of the explicit grid. Zero is auto.
+		int end = 0;
+		int span = 1;
+	};
+
+	struct GridItem {
+		Element* element = nullptr;
+		Box box;
+		Placement placement[2]; // [0] columns, [1] rows
+		int start[2] = {-1, -1};
+		int span[2] = {1, 1};
+		float edges[2] = {0.f, 0.f};    // Margin, border and padding across each axis
+		float margin_a[2] = {0.f, 0.f}; // Left and top margins
+		float contribution[2] = {0.f, 0.f};
+		Style::AlignSelf align = Style::AlignSelf::Stretch;
+		int justify = 0; // JustifySelf without auto: stretch, start, end, center
+	};
+
+	struct Track {
+		TrackSize size;
+		float base = 0.f;
+		float content = 0.f;
+	};
+
+	enum class Justify { Stretch, Start, End, Center };
+
+	// Splits on whitespace and commas outside parentheses.
+	StringList SplitTopLevel(const String& value, bool on_comma)
+	{
+		StringList result;
+		String current;
+		int depth = 0;
+		for (const char c : value)
+		{
+			if (c == '(')
+				depth++;
+			else if (c == ')')
+				depth--;
+
+			const bool separator = depth == 0 && (on_comma ? c == ',' : StringUtilities::IsWhitespace(c));
+			if (separator)
+			{
+				if (!StringUtilities::StripWhitespace(current).empty())
+					result.push_back(StringUtilities::StripWhitespace(current));
+				current.clear();
+			}
+			else
+				current += c;
+		}
+		if (!StringUtilities::StripWhitespace(current).empty())
+			result.push_back(StringUtilities::StripWhitespace(current));
+		return result;
+	}
+
+	bool StartsWith(const String& value, const char* prefix)
+	{
+		const String lower = StringUtilities::ToLower(value.substr(0, strlen(prefix)));
+		return lower == prefix;
+	}
+
+	// The inside of name(...).
+	String Arguments(const String& value)
+	{
+		const size_t open = value.find('(');
+		const size_t close = value.rfind(')');
+		if (open == String::npos || close == String::npos || close <= open)
+			return String();
+		return value.substr(open + 1, close - open - 1);
+	}
+
+	bool ParseBound(const String& token, TrackBound& bound)
+	{
+		const String lower = StringUtilities::ToLower(token);
+		if (lower == "auto" || lower == "min-content" || lower == "max-content")
+		{
+			bound.kind = TrackKind::Auto;
+			return true;
+		}
+		if (lower.size() > 2 && lower.compare(lower.size() - 2, 2, "fr") == 0)
+		{
+			char* end = nullptr;
+			bound.fr = strtof(lower.c_str(), &end);
+			bound.kind = TrackKind::Fr;
+			return end != lower.c_str();
+		}
+
+		static PropertyParser* parser = StyleSheetSpecification::GetParser("length_percent");
+		Property property;
+		if (!parser || !parser->ParseValue(property, token, ParameterMap()))
+			return false;
+		bound.kind = TrackKind::Length;
+		bound.length = property.GetNumericValue();
+		return true;
+	}
+
+	bool ParseTrack(const String& token, TrackSize& track)
+	{
+		if (StartsWith(token, "minmax("))
+		{
+			const StringList bounds = SplitTopLevel(Arguments(token), true);
+			if (bounds.size() != 2 || !ParseBound(bounds[0], track.min) || !ParseBound(bounds[1], track.max))
+				return false;
+			// A fraction is no minimum.
+			if (track.min.kind == TrackKind::Fr)
+				track.min.kind = TrackKind::Auto;
+			return true;
+		}
+
+		TrackBound bound;
+		if (!ParseBound(token, bound))
+			return false;
+		track.max = bound;
+		track.min = (bound.kind == TrackKind::Fr ? TrackBound{TrackKind::Length, NumericValue(0.f, Unit::PX), 0.f} : bound);
+		return true;
+	}
+
+	void ParseTrackList(const String& value, Vector<TrackSize>& tracks, Element* element)
+	{
+		tracks.clear();
+		const String lower = StringUtilities::ToLower(StringUtilities::StripWhitespace(value));
+		if (lower.empty() || lower == "none")
+			return;
+
+		for (const String& token : SplitTopLevel(value, false))
+		{
+			if (StartsWith(token, "repeat("))
+			{
+				const StringList arguments = SplitTopLevel(Arguments(token), true);
+				if (arguments.size() != 2)
+					continue;
+				const int count = Math::Clamp(atoi(arguments[0].c_str()), 0, 1000);
+				Vector<TrackSize> pattern;
+				for (const String& item : SplitTopLevel(arguments[1], false))
+				{
+					TrackSize track;
+					if (ParseTrack(item, track))
+						pattern.push_back(track);
+				}
+				for (int i = 0; i < count; i++)
+					tracks.insert(tracks.end(), pattern.begin(), pattern.end());
+				continue;
+			}
+
+			TrackSize track;
+			if (ParseTrack(token, track))
+				tracks.push_back(track);
+			else
+				Log::Message(Log::LT_WARNING, "Invalid grid track '%s' in %s", token.c_str(), element->GetAddress().c_str());
+		}
+	}
+
+	// One side of grid-column or grid-row: auto, a line, or span n.
+	void ParseLine(const String& value, int& line, int& span)
+	{
+		const StringList words = SplitTopLevel(value, false);
+		line = 0;
+		span = 0;
+		for (size_t i = 0; i < words.size(); i++)
+		{
+			const String word = StringUtilities::ToLower(words[i]);
+			if (word == "span")
+				span = (i + 1 < words.size() ? Math::Max(1, atoi(words[++i].c_str())) : 1);
+			else if (word != "auto")
+				line = atoi(word.c_str());
+		}
+	}
+
+	Placement ParsePlacement(const String& value)
+	{
+		Placement placement;
+		const size_t slash = value.find('/');
+		int start_line = 0, start_span = 0, end_line = 0, end_span = 0;
+		ParseLine(value.substr(0, slash), start_line, start_span);
+		if (slash != String::npos)
+			ParseLine(value.substr(slash + 1), end_line, end_span);
+
+		placement.start = start_line;
+		placement.end = end_line;
+		placement.span = Math::Max(1, start_span > 0 ? start_span : end_span > 0 ? end_span : 1);
+		return placement;
+	}
+
+	String GetStringProperty(Element* element, PropertyId id)
+	{
+		const Property* property = element->GetProperty(id);
+		return property && property->unit == Unit::STRING ? property->Get<String>() : String();
+	}
+
+	float ResolveBound(Element* element, const TrackBound& bound, float base)
+	{
+		if (bound.kind != TrackKind::Length)
+			return 0.f;
+		if (bound.length.unit == Unit::PERCENT && base < 0.f)
+			return 0.f;
+		return Math::Max(0.f, element->ResolveNumericValue(bound.length, Math::Max(base, 0.f)));
+	}
+
+	// Whether a percentage track has nothing to be a percentage of, which makes it auto.
+	bool IsIndefinite(const TrackBound& bound, float available)
+	{
+		return bound.kind == TrackKind::Length && available < 0.f && Any(bound.length.unit & (Unit::PERCENT | Unit::CALC));
+	}
+
+	// Resolves an item's lines against an explicit grid of `explicit_count` tracks to a start track and span.
+	// Returns false when the item has no definite start on this axis.
+	bool ResolveLines(const Placement& placement, int explicit_count, int& start, int& span)
+	{
+		// Line -1 is the last line of the explicit grid, which is line explicit_count + 1.
+		auto ToTrack = [explicit_count](int line) { return line > 0 ? line - 1 : explicit_count + 1 + line; };
+
+		span = placement.span;
+		if (placement.start != 0 && placement.end != 0)
+		{
+			int a = ToTrack(placement.start), b = ToTrack(placement.end);
+			if (b < a)
+				std::swap(a, b);
+			start = a;
+			span = Math::Max(1, b - a);
+		}
+		else if (placement.start != 0)
+			start = ToTrack(placement.start);
+		else if (placement.end != 0)
+			start = ToTrack(placement.end) - span;
+		else
+			return false;
+
+		start = Math::Max(0, start);
+		return true;
+	}
+
+	class Occupancy {
+	public:
+		Occupancy(int minor_count) : minor_count(Math::Max(1, minor_count)) {}
+
+		int MinorCount() const { return minor_count; }
+
+		bool Fits(int major, int minor, int major_span, int minor_span) const
+		{
+			if (minor < 0 || minor + minor_span > minor_count)
+				return false;
+			for (int a = major; a < major + major_span; a++)
+			{
+				if (a >= (int)cells.size())
+					continue;
+				for (int b = minor; b < minor + minor_span; b++)
+					if (cells[a][b])
+						return false;
+			}
+			return true;
+		}
+
+		void Mark(int major, int minor, int major_span, int minor_span)
+		{
+			if ((int)cells.size() < major + major_span)
+				cells.resize(major + major_span, Vector<char>(minor_count, 0));
+			for (int a = major; a < major + major_span; a++)
+				for (int b = minor; b < Math::Min(minor + minor_span, minor_count); b++)
+					cells[a][b] = 1;
+		}
+
+		int MajorCount() const { return (int)cells.size(); }
+
+	private:
+		int minor_count;
+		Vector<Vector<char>> cells;
+	};
+
+	// Places every item, growing the implicit grid. Axis 0 is columns. The flow axis is the one placement advances
+	// along, which for row flow is the rows: items fill across the columns, then move down.
+	void PlaceItems(Vector<GridItem>& items, int explicit_count[2], bool column_flow, int out_count[2])
+	{
+		const int major = column_flow ? 0 : 1;
+		const int minor = 1 - major;
+
+		int minor_count = explicit_count[minor];
+		for (GridItem& item : items)
+		{
+			for (int axis = 0; axis < 2; axis++)
+			{
+				int start = -1, span = 1;
+				if (ResolveLines(item.placement[axis], explicit_count[axis], start, span))
+					item.start[axis] = start;
+				else
+					item.start[axis] = -1;
+				item.span[axis] = span;
+			}
+			minor_count = Math::Max(minor_count, (item.start[minor] >= 0 ? item.start[minor] : 0) + item.span[minor]);
+		}
+
+		Occupancy occupancy(minor_count);
+
+		// Fully placed first, then those fixed on the flow axis, then everything else in order.
+		for (GridItem& item : items)
+			if (item.start[0] >= 0 && item.start[1] >= 0)
+				occupancy.Mark(item.start[major], item.start[minor], item.span[major], item.span[minor]);
+
+		for (GridItem& item : items)
+		{
+			if (item.start[major] < 0 || item.start[minor] >= 0)
+				continue;
+			int b = 0;
+			while (!occupancy.Fits(item.start[major], b, item.span[major], item.span[minor]) && b + item.span[minor] <= occupancy.MinorCount())
+				b++;
+			item.start[minor] = (b + item.span[minor] <= occupancy.MinorCount() ? b : 0);
+			occupancy.Mark(item.start[major], item.start[minor], item.span[major], item.span[minor]);
+		}
+
+		int cursor_major = 0, cursor_minor = 0;
+		for (GridItem& item : items)
+		{
+			if (item.start[major] >= 0)
+				continue;
+
+			if (item.start[minor] >= 0)
+			{
+				// Fixed across: the next free place at or after the cursor in that position.
+				if (item.start[minor] < cursor_minor)
+					cursor_major++;
+				while (!occupancy.Fits(cursor_major, item.start[minor], item.span[major], item.span[minor]))
+					cursor_major++;
+				item.start[major] = cursor_major;
+				cursor_minor = item.start[minor] + item.span[minor];
+			}
+			else
+			{
+				for (;;)
+				{
+					if (cursor_minor + item.span[minor] > occupancy.MinorCount())
+					{
+						cursor_major++;
+						cursor_minor = 0;
+					}
+					if (occupancy.Fits(cursor_major, cursor_minor, item.span[major], item.span[minor]))
+						break;
+					cursor_minor++;
+				}
+				item.start[major] = cursor_major;
+				item.start[minor] = cursor_minor;
+				cursor_minor += item.span[minor];
+			}
+			occupancy.Mark(item.start[major], item.start[minor], item.span[major], item.span[minor]);
+		}
+
+		out_count[minor] = occupancy.MinorCount();
+		out_count[major] = Math::Max(explicit_count[major], occupancy.MajorCount());
+	}
+
+	// Sizes one axis' tracks. available is the content size on this axis, negative when indefinite.
+	void SizeTracks(Vector<Track>& tracks, const Vector<GridItem>& items, int axis, float available, float gap, Element* element)
+	{
+		const int count = (int)tracks.size();
+		for (Track& track : tracks)
+		{
+			track.base = track.content = 0.f;
+			if (!IsIndefinite(track.size.min, available))
+				track.base = ResolveBound(element, track.size.min, available);
+		}
+
+		// Content first from items in one track, then what wider items still need, shared among the auto tracks they cross.
+		for (const GridItem& item : items)
+		{
+			if (item.span[axis] != 1)
+				continue;
+			Track& track = tracks[item.start[axis]];
+			track.content = Math::Max(track.content, item.contribution[axis]);
+		}
+		for (const GridItem& item : items)
+		{
+			if (item.span[axis] == 1)
+				continue;
+			float covered = gap * float(item.span[axis] - 1);
+			int autos = 0;
+			for (int i = item.start[axis]; i < item.start[axis] + item.span[axis]; i++)
+			{
+				covered += Math::Max(tracks[i].base, tracks[i].content);
+				autos += (tracks[i].size.max.kind == TrackKind::Auto ? 1 : 0);
+			}
+			const float extra = item.contribution[axis] - covered;
+			if (extra > 0.f && autos > 0)
+				for (int i = item.start[axis]; i < item.start[axis] + item.span[axis]; i++)
+					if (tracks[i].size.max.kind == TrackKind::Auto)
+						tracks[i].content += extra / float(autos);
+		}
+
+		float total_fr = 0.f;
+		for (Track& track : tracks)
+		{
+			const bool min_auto = track.size.min.kind == TrackKind::Auto || IsIndefinite(track.size.min, available);
+			const bool max_auto = track.size.max.kind == TrackKind::Auto || IsIndefinite(track.size.max, available);
+			if (track.size.max.kind == TrackKind::Fr)
+			{
+				total_fr += track.size.max.fr;
+				// With nothing to divide, a fraction is as large as what is in it.
+				if (available < 0.f)
+					track.base = Math::Max(track.base, track.content);
+			}
+			else if (min_auto || max_auto)
+				track.base = Math::Max(track.base, track.content);
+			else
+				track.base = Math::Max(track.base, ResolveBound(element, track.size.max, available));
+
+			if (track.size.max.kind == TrackKind::Length && !max_auto)
+				track.base = Math::Min(Math::Max(track.base, ResolveBound(element, track.size.min, available)),
+					Math::Max(ResolveBound(element, track.size.max, available), ResolveBound(element, track.size.min, available)));
+		}
+
+		const float gaps = gap * float(Math::Max(0, count - 1));
+
+		if (total_fr > 0.f)
+		{
+			if (available >= 0.f)
+			{
+				float fixed = gaps;
+				for (const Track& track : tracks)
+					if (track.size.max.kind != TrackKind::Fr)
+						fixed += track.base;
+				// Fractions summing to less than one leave the rest of the space empty, as CSS does.
+				const float unit = Math::Max(0.f, available - fixed) / Math::Max(total_fr, 1.f);
+				for (Track& track : tracks)
+					if (track.size.max.kind == TrackKind::Fr)
+						track.base = Math::Max(track.base, track.size.max.fr * unit);
+			}
+			else
+			{
+				// Indefinite: the largest content-per-fraction decides the unit, so the fractions keep their ratio.
+				float unit = 0.f;
+				for (const Track& track : tracks)
+					if (track.size.max.kind == TrackKind::Fr && track.size.max.fr > 0.f)
+						unit = Math::Max(unit, track.base / track.size.max.fr);
+				for (Track& track : tracks)
+					if (track.size.max.kind == TrackKind::Fr)
+						track.base = track.size.max.fr * unit;
+			}
+			return;
+		}
+
+		// No fractions: what is left stretches the auto tracks, as CSS does under the default content alignment.
+		if (available >= 0.f)
+		{
+			float used = gaps;
+			int autos = 0;
+			for (const Track& track : tracks)
+			{
+				used += track.base;
+				autos += (track.size.max.kind == TrackKind::Auto ? 1 : 0);
+			}
+			const float free = available - used;
+			if (free > 0.f && autos > 0)
+				for (Track& track : tracks)
+					if (track.size.max.kind == TrackKind::Auto)
+						track.base += free / float(autos);
+		}
+	}
+
+	float SpanSize(const Vector<float>& offsets, const Vector<Track>& tracks, int start, int span)
+	{
+		const int last = Math::Min(start + span, (int)tracks.size()) - 1;
+		return offsets[last] + tracks[last].base - offsets[start];
+	}
+
+} // namespace
