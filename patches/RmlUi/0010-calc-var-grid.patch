+UniquePtr<LayoutBox> GridFormattingContext::Format(ContainerBox* parent_container, Element* element, const Box* override_initial_box)
+{
+	RMLUI_ZoneScopedC(0x4FAFAF);
+	auto container_box = MakeUnique<FlexContainer>(element, parent_container);
+
+	ElementScroll* element_scroll = element->GetElementScroll();
+
+	const Vector2f containing_block = LayoutDetails::GetContainingBlock(parent_container, element->GetPosition()).size;
+	RMLUI_ASSERT(containing_block.x >= 0.f);
+
+	Box& box = container_box->GetBox();
+	if (override_initial_box)
+		box = *override_initial_box;
+	else
+		LayoutDetails::BuildBox(box, containing_block, element, BuildBoxMode::Block);
+
+	container_box->ResetScrollbars(box);
+
+	GridFormattingContext context;
+	context.container_box = container_box.get();
+	context.element_grid = element;
+
+	const Vector2f box_content_size = box.GetSize();
+	const bool auto_height = (box_content_size.y < 0.0f);
+
+	context.content_offset = box.GetPosition();
+
+	for (int layout_iteration = 0; layout_iteration < 3; layout_iteration++)
+	{
+		const Vector2f scrollbar_size = {
+			element_scroll->GetScrollbarSize(ElementScroll::VERTICAL),
+			element_scroll->GetScrollbarSize(ElementScroll::HORIZONTAL),
+		};
+
+		context.available_content_size = Math::Max(box_content_size - scrollbar_size, Vector2f(0.f));
+		context.content_containing_block = context.available_content_size;
+
+		if (auto_height)
+		{
+			context.available_content_size.y = -1.f;
+			context.content_containing_block.y = containing_block.y;
+		}
+
+		Vector2f resulting_content_size, content_overflow_size;
+		float baseline = 0.f;
+		context.Format(resulting_content_size, content_overflow_size, baseline);
+
+		Vector2f formatted_content_size = box_content_size;
+		if (auto_height)
+			formatted_content_size.y = resulting_content_size.y + scrollbar_size.y;
+
+		Box sized_box = box;
+		sized_box.SetContent(formatted_content_size);
+
+		const float element_baseline =
+			sized_box.GetSizeAcross(BoxDirection::Vertical, BoxArea::Border) + sized_box.GetEdge(BoxArea::Margin, BoxEdge::Bottom) - baseline;
+
+		if (container_box->Close(content_overflow_size, sized_box, element_baseline))
+			break;
+	}
+
+	return container_box;
+}
+
+Vector2f GridFormattingContext::GetMaxContentSize(Element* element)
+{
+	const Vector2f infinity(10000.0f, 10000.0f);
+	RootBox root(infinity);
+	auto container_box = MakeUnique<FlexContainer>(element, &root);
+
+	GridFormattingContext context;
+	context.container_box = container_box.get();
+	context.element_grid = element;
+	context.available_content_size = Vector2f(-1, -1);
+	context.content_containing_block = infinity;
+
+	Vector2f resulting_content_size, content_overflow_size;
+	float baseline = 0.f;
+	context.Format(resulting_content_size, content_overflow_size, baseline);
+	return resulting_content_size;
+}
+
+void GridFormattingContext::Format(Vector2f& resulting_content_size, Vector2f& content_overflow_size, float& baseline) const
+{
+	RMLUI_ZoneScopedC(0x4FAFAF);
+
+	const ComputedValues& computed_grid = element_grid->GetComputedValues();
+	const float base_width = Math::Max(available_content_size.x, 0.f);
+	const float base_height = Math::Max(available_content_size.y, 0.f);
+	const float gap[2] = {
+		ResolveValue(computed_grid.column_gap(), base_width),
+		ResolveValue(computed_grid.row_gap(), base_height),
+	};
+
+	Vector<TrackSize> templates[2], autos[2];
+	ParseTrackList(GetStringProperty(element_grid, PropertyId::GridTemplateColumns), templates[0], element_grid);
+	ParseTrackList(GetStringProperty(element_grid, PropertyId::GridTemplateRows), templates[1], element_grid);
+	ParseTrackList(GetStringProperty(element_grid, PropertyId::GridAutoColumns), autos[0], element_grid);
+	ParseTrackList(GetStringProperty(element_grid, PropertyId::GridAutoRows), autos[1], element_grid);
+
+	const Property* flow = element_grid->GetProperty(PropertyId::GridAutoFlow);
+	const bool column_flow = flow && flow->unit == Unit::KEYWORD && flow->Get<int>() == 1;
+
+	const Property* justify_items_property = element_grid->GetProperty(PropertyId::JustifyItems);
+	const int justify_items = justify_items_property && justify_items_property->unit == Unit::KEYWORD ? justify_items_property->Get<int>() : 0;
+
+	// -- Items --
+	Vector<GridItem> items;
+	const int num_children = element_grid->GetNumChildren();
+	items.reserve(num_children);
+
+	for (int i = 0; i < num_children; i++)
+	{
+		Element* element = element_grid->GetChild(i);
+		const ComputedValues& computed = element->GetComputedValues();
+
+		if (computed.display() == Style::Display::None)
+			continue;
+		if (computed.position() == Style::Position::Absolute || computed.position() == Style::Position::Fixed)
+		{
+			ContainerBox* absolute_containing_block = LayoutDetails::GetContainingBlock(container_box, computed.position()).container;
+			absolute_containing_block->AddAbsoluteElement(element, {}, element_grid);
+			continue;
+		}
+		if (computed.position() == Style::Position::Relative)
+			container_box->AddRelativeElement(element);
+
+		GridItem item;
+		item.element = element;
+		item.placement[0] = ParsePlacement(GetStringProperty(element, PropertyId::GridColumn));
+		item.placement[1] = ParsePlacement(GetStringProperty(element, PropertyId::GridRow));
+
+		item.align = computed.align_self();
+		if (item.align == Style::AlignSelf::Auto)
+			item.align = static_cast<Style::AlignSelf>(static_cast<int>(computed_grid.align_items()) + 1);
+
+		const Property* justify_self = element->GetProperty(PropertyId::JustifySelf);
+		const int justify_self_value = justify_self && justify_self->unit == Unit::KEYWORD ? justify_self->Get<int>() : 0;
+		item.justify = (justify_self_value == 0 ? justify_items : justify_self_value - 1);
+
+		items.push_back(std::move(item));
+	}
+
+	int explicit_count[2] = {(int)templates[0].size(), (int)templates[1].size()};
+	int track_count[2] = {0, 0};
+	PlaceItems(items, explicit_count, column_flow, track_count);
+
+	Vector<Track> tracks[2];
+	for (int axis = 0; axis < 2; axis++)
+	{
+		tracks[axis].resize(track_count[axis]);
+		for (int i = 0; i < track_count[axis]; i++)
+		{
+			if (i < explicit_count[axis])
+				tracks[axis][i].size = templates[axis][i];
+			else if (!autos[axis].empty())
+				tracks[axis][i].size = autos[axis][(i - explicit_count[axis]) % autos[axis].size()];
+			// Otherwise auto, which a value-initialised TrackSize already is.
+		}
+	}
+
+	// Boxes are built against the grid's content area. The cell is not known yet, and what a percentage size on an
+	// item means is left as it would be in a block.
+	for (GridItem& item : items)
+	{
+		LayoutDetails::BuildBox(item.box, content_containing_block, item.element, BuildBoxMode::UnalignedBlock);
+		const Box& b = item.box;
+		item.edges[0] = b.GetEdge(BoxArea::Margin, BoxEdge::Left) + b.GetEdge(BoxArea::Margin, BoxEdge::Right) +
+			b.GetEdge(BoxArea::Border, BoxEdge::Left) + b.GetEdge(BoxArea::Border, BoxEdge::Right) + b.GetEdge(BoxArea::Padding, BoxEdge::Left) +
+			b.GetEdge(BoxArea::Padding, BoxEdge::Right);
+		item.edges[1] = b.GetEdge(BoxArea::Margin, BoxEdge::Top) + b.GetEdge(BoxArea::Margin, BoxEdge::Bottom) +
+			b.GetEdge(BoxArea::Border, BoxEdge::Top) + b.GetEdge(BoxArea::Border, BoxEdge::Bottom) + b.GetEdge(BoxArea::Padding, BoxEdge::Top) +
+			b.GetEdge(BoxArea::Padding, BoxEdge::Bottom);
+		item.margin_a[0] = b.GetEdge(BoxArea::Margin, BoxEdge::Left);
+		item.margin_a[1] = b.GetEdge(BoxArea::Margin, BoxEdge::Top);
+
+		const float width = b.GetSize().x;
+		item.contribution[0] = (width >= 0.f ? width : LayoutDetails::GetShrinkToFitWidth(item.element, content_containing_block)) + item.edges[0];
+	}
+
+	// -- Columns, then rows from heights formatted at the column widths --
+	SizeTracks(tracks[0], items, 0, available_content_size.x, gap[0], element_grid);
+
+	Vector<float> offsets[2];
+	auto BuildOffsets = [&](int axis) {
+		offsets[axis].resize(tracks[axis].size());
+		float cursor = 0.f;
+		for (size_t i = 0; i < tracks[axis].size(); i++)
+		{
+			offsets[axis][i] = cursor;
+			cursor += tracks[axis][i].base + gap[axis];
+		}
+	};
+	BuildOffsets(0);
+
+	auto InnerWidthIn = [&](GridItem& item, float cell_width) {
+		const float own = item.box.GetSize().x;
+		if (own >= 0.f)
+			return own;
+		if (item.justify == int(Justify::Stretch))
+			return Math::Max(0.f, cell_width - item.edges[0]);
+		return Math::Max(0.f, Math::Min(item.contribution[0], cell_width) - item.edges[0]);
+	};
+
+	for (GridItem& item : items)
+	{
+		const float cell_width = SpanSize(offsets[0], tracks[0], item.start[0], item.span[0]);
+		const float own_height = item.box.GetSize().y;
+		if (own_height >= 0.f)
+		{
+			item.contribution[1] = own_height + item.edges[1];
+			continue;
+		}
+
+		Box format_box = item.box;
+		format_box.SetContent(Vector2f(InnerWidthIn(item, cell_width), -1.f));
+		FormattingContext::FormatIndependent(container_box, item.element, &format_box, FormattingContextType::Block);
+		item.contribution[1] = item.element->GetBox().GetSize().y + item.edges[1];
+	}
+
+	SizeTracks(tracks[1], items, 1, available_content_size.y, gap[1], element_grid);
+	BuildOffsets(1);
+
+	// -- Format items in their cells --
+	bool baseline_set = false;
+	for (GridItem& item : items)
+	{
+		const float cell_width = SpanSize(offsets[0], tracks[0], item.start[0], item.span[0]);
+		const float cell_height = SpanSize(offsets[1], tracks[1], item.start[1], item.span[1]);
+
+		float min_width, max_width, min_height, max_height;
+		const ComputedValues& computed = item.element->GetComputedValues();
+		LayoutDetails::GetMinMaxWidth(min_width, max_width, computed, item.box, content_containing_block.x);
+		LayoutDetails::GetMinMaxHeight(min_height, max_height, computed, item.box, content_containing_block.y);
+
+		const float inner_width = Math::Clamp(InnerWidthIn(item, cell_width), min_width, max_width);
+
+		float inner_height = item.box.GetSize().y;
+		if (inner_height < 0.f)
+		{
+			inner_height = (item.align == Style::AlignSelf::Stretch ? Math::Max(0.f, cell_height - item.edges[1])
+																	: Math::Max(0.f, item.contribution[1] - item.edges[1]));
+		}
+		inner_height = Math::Clamp(inner_height, min_height, max_height);
+
+		const float free_x = cell_width - (inner_width + item.edges[0]);
+		const float free_y = cell_height - (inner_height + item.edges[1]);
+
+		float x = offsets[0][item.start[0]] + item.margin_a[0];
+		switch (Justify(item.justify))
+		{
+		case Justify::End: x += free_x; break;
+		case Justify::Center: x += 0.5f * free_x; break;
+		default: break;
+		}
+
+		float y = offsets[1][item.start[1]] + item.margin_a[1];
+		switch (item.align)
+		{
+		case Style::AlignSelf::FlexEnd: y += free_y; break;
+		case Style::AlignSelf::Center: y += 0.5f * free_y; break;
+		default: break;
+		}
+
+		item.box.SetContent(Vector2f(inner_width, inner_height));
+		UniquePtr<LayoutBox> layout_box = FormattingContext::FormatIndependent(container_box, item.element, &item.box, FormattingContextType::Block);
+
+		const Vector2f item_offset(x, y);
+		item.element->SetOffset(content_offset + item_offset, element_grid);
+
+		if (!baseline_set && layout_box && layout_box->GetBaselineOfLastLine(baseline))
+		{
+			baseline += content_offset.y + item_offset.y;
+			baseline_set = true;
+		}
+
+		if (layout_box)
+			content_overflow_size = Math::Max(content_overflow_size, item_offset + layout_box->GetVisibleOverflowSize());
+	}
+
+	auto Extent = [&](int axis) {
+		if (tracks[axis].empty())
+			return 0.f;
+		return offsets[axis].back() + tracks[axis].back().base;
+	};
+
+	resulting_content_size.x = available_content_size.x >= 0.f ? available_content_size.x : Extent(0);
+	resulting_content_size.y = Extent(1);
+}
+
+} // namespace Rml
