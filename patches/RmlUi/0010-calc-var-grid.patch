+bool PropertySpecification::UsesVar(const String& value)
+{
+	for (size_t i = 0; i + 4 <= value.size(); i++)
+	{
+		if ((value[i] == 'v' || value[i] == 'V') && (value[i + 1] == 'a' || value[i + 1] == 'A') && (value[i + 2] == 'r' || value[i + 2] == 'R') &&
+			value[i + 3] == '(' && (i == 0 || !(std::isalnum((unsigned char)value[i - 1]) || value[i - 1] == '-')))
+			return true;
+	}
+	return false;
+}
+
+// The properties a shorthand finally sets, through any shorthands inside it.
+static void CollectShorthandLeaves(const ShorthandDefinition& definition, Vector<PropertyId>& leaves)
+{
+	for (const ShorthandItem& item : definition.items)
+	{
+		if (item.type == ShorthandItemType::Property)
+			leaves.push_back(item.property_id);
+		else if (item.type == ShorthandItemType::Shorthand && item.shorthand_definition)
+			CollectShorthandLeaves(*item.shorthand_definition, leaves);
+	}
+}
