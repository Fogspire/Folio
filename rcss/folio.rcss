/*
 * Folio's base stylesheet, the equivalent of a browser's user-agent stylesheet.
 *
 * RmlUi ships nothing like this and defaults every element to display: inline, so without it
 * a document renders as one run of overlapping text. It belongs to the plugin rather than to
 * any game's UI: it establishes what the elements mean, not what they look like.
 *
 * Import it as a root-absolute path, which resolves against Folio itself rather than the
 * content root:
 *
 *     <link type="text/rcss" href="/folio/folio.rcss"/>
 */

body, div, p, h1, h2, h3, h4, h5, h6,
section, header, footer, article, aside, nav,
ul, ol, li, dl, dt, dd, form, fieldset, figure, figcaption, main, pre, blockquote
{
	display: block;
}

/*
 * A document is laid out shrink-to-fit against the context, and display: block does not
 * change that, so without an explicit width the body collapses to its widest line.
 */
body
{
	width: 100%;
}

li { display: block; }

/*
 * `<text>` is a paragraph of styled, revealable prose. Its runs are built from its markup and
 * are inline, so they wrap as one block of text rather than stacking.
 */
text { display: block; }
text span { display: inline; }

em, i { font-style: italic; }
strong, b { font-weight: bold; }

table  { box-sizing: border-box; display: table; }
tr     { box-sizing: border-box; display: table-row; }
td, th { box-sizing: border-box; display: table-cell; }
col    { box-sizing: border-box; display: table-column; }
colgroup { display: table-column-group; }
thead, tbody, tfoot { display: table-row-group; }

/* Interactive elements are inline-block so they size to content but still take a box. */
button, input, select, textarea, progress, progressbar, handle { display: inline-block; }

/*
 * RmlUi's own tabset elements are as undeclared as everything else. The tabset shows and
 * hides panels by writing display onto them directly and removing it again, so the value a
 * panel returns to when it becomes active is whatever the stylesheet says - which is inline
 * unless it is stated here.
 */
tabset, tabs, panels, panel { display: block; }
tab { display: inline-block; }

.is-disabled, :disabled { color: #7f7f7f; }

/*
 * Scrollbars have no default size, and an auto width on one resolves to the full content
 * width of the container it belongs to. So the first time an overflow: auto container
 * actually overflows, its scrollbar takes the entire width and every child collapses to its
 * own padding and border. It looks like a flex bug and it is not one.
 *
 * Geometry only. Colours, decorators and the bar's look belong to the game.
 */
scrollbarvertical
{
	width: 10dp;
}

scrollbarvertical sliderbar
{
	width: 10dp;
	min-height: 32dp;
}

scrollbarhorizontal
{
	height: 10dp;
}

scrollbarhorizontal sliderbar
{
	height: 10dp;
	min-width: 32dp;
}

/* The stepper arrows are a mouse-only affordance and are off unless a game asks for them. */
scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc,
scrollbarhorizontal sliderarrowdec,
scrollbarhorizontal sliderarrowinc
{
	width: 0dp;
	height: 0dp;
}

/*
 * Reduced motion, which is a setting rather than a taste.
 *
 * Here rather than in a theme because it is not about how anything looks: a game with its own
 * stylesheet still gets it, and gets it on elements the theme has never heard of. Turn it on with
 * Set Reduced Motion, or folio.Accessibility.ReducedMotion.
 *
 * Movement a player cannot stop is what this exists for - vestibular disorders make large motion
 * genuinely unpleasant, and a menu that slides, scales and parallaxes is the usual trigger. It cannot
 * reach movement that is drawn rather than animated: a HUD spring, a shader, a video. Those read
 * Folio::Presentation::IsReducedMotionOn and snap.
 */
@media (theme: reduced-motion)
{
	*
	{
		transition: none;
		animation: none;
	}
}

/*
 * Full-screen effect layers, off.
 *
 * The washes and flashes a game paints over the whole view: a damage vignette, a burning tint, a hit
 * flash. Three separate problems in one - a coloured wash over the HUD is a legibility problem, a
 * breathing overlay is a motion problem, and a hit flash is a photosensitivity problem - and a player
 * who needs any of them gone usually needs all of them gone.
 *
 * Folio cannot tell a vignette from a panel, so the author marks the layers: `folio-screen-effect` on
 * each one. Mark what covers the view and reads as an effect; leave anything a player needs to see.
 * Turn it on with Set Screen Effects, or folio.Accessibility.ScreenEffects.
 */
@media (theme: no-screen-effects)
{
	[folio-screen-effect]
	{
		display: none;
	}
}
