/*
 * Input prompts: "press this to do that".
 *
 * Structure only, no colour - the skin is in the theme, like every other component.
 *
 * Every glyph here is drawn from boxes, borders and radii. That is deliberate rather than a
 * limitation: a drawn glyph is sharp at any size, recolours with the theme, needs no atlas and no
 * per-platform art request, and is usually what a stylised game wants anyway. A project that has
 * licensed button art points the same prompt at `.pg-image` instead and nothing else changes.
 *
 * The three sources a prompt can carry, one per element:
 *
 *   .pg-drawn   these shapes
 *   .pg-sprite  a sprite from the game's own spritesheet
 *   .pg-image   a texture the game registered, which is how CommonInput's brushes arrive
 */

.prompt {
	display: inline-block;
	vertical-align: middle;
}

.prompt-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 22dp;
}

/* No size here: each shape sets its own, and a rule with two selectors would beat every one. */
.pg {
	display: inline-block;
	vertical-align: middle;
	position: relative;
	box-sizing: border-box;
}

.pg-label {
	display: inline-block;
	vertical-align: middle;
	margin-left: 0.470588em;
}

/* ------------------------------------------------------------------------ keycap */

/*
 * A key, with a skirt. The cap grows with its text rather than wrapping it, which is what makes F
 * and LSHIFT the same rule, and the thicker bottom border is the moulding a real cap has - one
 * property instead of a second element.
 */
/*
 * An automatic width comes out as the padding on one side plus the text, so a cap sized purely by
 * its label runs its last letter under the right border. The minimum is what actually holds a cap
 * open; six characters fit, which covers LSHIFT and everything shorter.
 */
.pg-key {
	width: auto;
	min-width: 3.466667em;
	height: 2.133333em;
	padding: 0em 0.666667em 0em 0.666667em;
	border-width: 0.133333em;
	border-bottom-width: 0.333333em;
	border-radius: 0.466667em 0.466667em 0.533333em 0.533333em;
	text-align: center;
	line-height: 1.666667em;
}

/* ------------------------------------------------------------------------- mouse */

/*
 * A mouse seen from above: rounded shoulders, a straighter tail, a seam between the two buttons and
 * a wheel across it. The button the prompt is about is filled rather than labelled.
 */
.pg-mouse { width: 1.733333em; height: 2.4em; }

.pg-mouse .body {
	position: absolute;
	left: 0em;
	top: 0em;
	right: 0em;
	bottom: 0em;
	border-width: 0.133333em;
	border-radius: 0.866667em 0.866667em 0.533333em 0.533333em;
	box-sizing: border-box;
}

.pg-mouse .lmb, .pg-mouse .rmb {
	position: absolute;
	top: 0.133333em;
	width: 0.666667em;
	height: 0.8em;
}

.pg-mouse .lmb { left: 0.133333em; border-radius: 0.733333em 0em 0em 0em; }
.pg-mouse .rmb { right: 0.133333em; border-radius: 0em 0.733333em 0em 0em; }

/* The line the two buttons meet on, and the one under them. */
.pg-mouse .seam {
	position: absolute;
	left: 0.733333em;
	top: 0.133333em;
	width: 0.133333em;
	height: 0.866667em;
}

.pg-mouse .rail {
	position: absolute;
	left: 0.133333em;
	right: 0.133333em;
	top: 1em;
	height: 0.133333em;
}

.pg-mouse .wheel {
	position: absolute;
	left: 0.666667em;
	top: 0.2em;
	width: 0.266667em;
	height: 0.666667em;
	border-radius: 0.2em 0.2em 0.2em 0.2em;
	border-width: 0.066667em;
	box-sizing: border-box;
}

/* Side buttons, for the two thumb keys a prompt otherwise has no way to point at. */
.pg-mouse .side {
	position: absolute;
	left: -0.133333em;
	top: 1.133333em;
	width: 0.266667em;
	height: 0.466667em;
	border-radius: 0.133333em 0em 0em 0.133333em;
}

.pg-mouse .side.two { top: 1.733333em; }

/* --------------------------------------------------------------------- face pads */

.pg-face {
	width: 2em;
	height: 2em;
	border-width: 0.133333em;
	border-radius: 1.333333em 1.333333em 1.333333em 1.333333em;
	text-align: center;
	line-height: 1.733333em;
}

/*
 * PlayStation's four marks, drawn. A letter would be wrong on that platform and a sprite would be
 * art nobody has yet, so they are bars and rings positioned inside the same circle.
 */
.pg-face .mark {
	position: absolute;
	left: 0em;
	top: 0em;
	right: 0em;
	bottom: 0em;
}

.pg-face .mark u {
	position: absolute;
	display: block;
}

/* Cross: two bars through the middle. */
.pg-cross .mark u { left: 0.333333em; top: 0.766667em; width: 1.066667em; height: 0.2em; }
.pg-cross .mark u:nth-child(1) { transform: rotate(45deg); }
.pg-cross .mark u:nth-child(2) { transform: rotate(-45deg); }
.pg-cross .mark u:nth-child(3) { display: none; }

/* Circle: a ring inside the pad. */
.pg-circle .mark u:nth-child(1) {
	left: 0.466667em;
	top: 0.466667em;
	width: 0.8em;
	height: 0.8em;
	border-width: 0.133333em;
	border-radius: 0.533333em 0.533333em 0.533333em 0.533333em;
	box-sizing: border-box;
}

.pg-circle .mark u:nth-child(2) { display: none; }

/* Square. */
.pg-square .mark u:nth-child(1) {
	left: 0.533333em;
	top: 0.533333em;
	width: 0.666667em;
	height: 0.666667em;
	border-width: 0.133333em;
	box-sizing: border-box;
}

.pg-square .mark u:nth-child(2) { display: none; }

/* Triangle: three bars of the same length, each turned into one side. */
.pg-triangle .mark u { width: 1em; height: 0.2em; }
.pg-triangle .mark u:nth-child(1) { left: 0.366667em; top: 1.053333em; }
.pg-triangle .mark u:nth-child(2) { left: 0.12em; top: 0.62em; transform: rotate(-60deg); }
.pg-triangle .mark u:nth-child(3) { left: 0.62em; top: 0.62em; transform: rotate(60deg); }

/* --------------------------------------------------------- shoulders and triggers */

.pg-bumper {
	width: auto;
	min-width: 2.4em;
	height: 1.6em;
	padding: 0em 0.4em 0em 0.4em;
	border-width: 0.133333em;
	border-radius: 0.8em 0.8em 0.333333em 0.333333em;
	text-align: center;
	line-height: 1.333333em;
}

.pg-trigger {
	width: auto;
	min-width: 2.4em;
	height: 1.866667em;
	padding: 0em 0.4em 0em 0.4em;
	border-width: 0.133333em;
	border-radius: 0.933333em 0.933333em 0.266667em 0.266667em;
	text-align: center;
	line-height: 1.6em;
}

/* ------------------------------------------------------------------------ sticks */

.pg-stick { width: 2em; height: 2em; }

.pg-stick .base {
	position: absolute;
	left: 0em;
	top: 0em;
	right: 0em;
	bottom: 0em;
	border-width: 0.133333em;
	border-radius: 1.333333em 1.333333em 1.333333em 1.333333em;
	box-sizing: border-box;
}

.pg-stick .top {
	position: absolute;
	left: 0.533333em;
	top: 0.533333em;
	width: 0.933333em;
	height: 0.933333em;
	border-radius: 0.6em 0.6em 0.6em 0.6em;
}

/* A pushed direction moves the cap, which reads faster than an arrow beside it. */
.pg-stick.up .top    { top: 0.266667em; }
.pg-stick.down .top  { top: 0.8em; }
.pg-stick.left .top  { left: 0.266667em; }
.pg-stick.right .top { left: 0.8em; }

/* ------------------------------------------------------------------------- d-pad */

.pg-dpad { width: 2em; height: 2em; }

.pg-dpad u {
	position: absolute;
	display: block;
	border-width: 0.133333em;
	box-sizing: border-box;
}

.pg-dpad u:nth-child(1) { left: 0.666667em; top: 0.066667em; width: 0.666667em; height: 0.8em; }
.pg-dpad u:nth-child(2) { left: 0.666667em; bottom: 0.066667em; width: 0.666667em; height: 0.8em; }
.pg-dpad u:nth-child(3) { left: 0.066667em; top: 0.666667em; width: 0.8em; height: 0.666667em; }
.pg-dpad u:nth-child(4) { right: 0.066667em; top: 0.666667em; width: 0.8em; height: 0.666667em; }

/* ------------------------------------------------------------- the other sources */

.pg-sprite, .pg-image { width: 2.133333em; height: 2.133333em; }

.pg-image img { width: 2em; height: 2em; }

/* Nothing bound. Shown rather than hidden, so a missing binding is visible in the screen. */
.pg-unbound {
	width: 2em;
	height: 2em;
	border-width: 0.133333em;
	border-radius: 0.4em 0.4em 0.4em 0.4em;
	text-align: center;
	line-height: 1.733333em;
}
