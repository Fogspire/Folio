/*
 * The default theme: every value the library refuses to hard-code.
 *
 * RCSS has no custom properties and no var() in RmlUi 6.2, so a token cannot be a variable. A theme
 * is therefore an *override block*, not a swapped value, and that decides the whole shape of this
 * file: it declares token classes a document can apply directly, and it skins the library's own
 * classes. A game overrides by loading its own stylesheet after this one and restating the rules it
 * disagrees with.
 *
 * Which in turn is why nothing under lib/ may contain a colour. A colour there could not be
 * overridden without restating the component's whole rule, so the first game to want a different
 * button would fork the library.
 *
 * Naming: c- colour, t- type, s- spacing, g- gap, r- radius, e- elevation, x- effect.
 * A c- token sets whichever of background-color or color its role implies; the -on tokens are the
 * foreground colours that pair with a filled background.
 */
/* --- Surfaces ---------------------------------------------------------------------- */

.c-sunken   { background-color: #0e0e13; }
.c-bg       { background-color: #2c2cd1; }
.c-surface  { background-color: #1f1f28; }
.c-raised   { background-color: #2b2b36; }
.c-overlay  { background-color: #363642; }
.c-scrim    { background-color: #0a0a0ec2; }

/* --- Foreground ------------------------------------------------------------------- */

.c-text     { color: #e8e8f0; }
.c-muted    { color: #a8a8b8; }
.c-dim      { color: #8a8a99; }
.c-accent   { color: #f0c674; }
.c-danger   { color: #e06c75; }
.c-success  { color: #98c379; }
.c-warn     { color: #d19a66; }
.c-info     { color: #61afef; }

/* Foregrounds for text sitting on a filled accent or danger background. */
.c-on-accent { color: #14141a; }
.c-on-danger { color: #14141a; }

/* --- Fills ------------------------------------------------------------------------ */

.c-fill-accent  { background-color: #f0c674; }
.c-fill-danger  { background-color: #e06c75; }
.c-fill-success { background-color: #98c379; }

/* --- Lines ------------------------------------------------------------------------ */

.c-line       { border-color: #3a3a48; }
.c-line-accent{ border-color: #f0c674; }

/* --- Type scale ------------------------------------------------------------------- */

.t-display  { font-size: 2rem; font-weight: bold; line-height: 1.15; }
.t-title    { font-size: 1.4rem; font-weight: bold; line-height: 1.2; }
.t-heading  { font-size: 1.1rem; font-weight: bold; line-height: 1.25; }
.t-body     { font-size: 1rem; line-height: 1.4; }
.t-label    { font-size: 0.9rem; line-height: 1.3; }
.t-small    { font-size: 0.8rem; line-height: 1.4; }
.t-caption  { font-size: 0.65rem; line-height: 1.3; text-transform: uppercase; letter-spacing: 1dp; }

.t-numeric  { font-weight: bold; letter-spacing: 0.5dp; }

/* --- Spacing ---------------------------------------------------------------------- */

.s-pad-xs   { padding: 4dp; }
.s-pad-s    { padding: 8dp; }
.s-pad-m    { padding: 16dp; }
.s-pad-l    { padding: 24dp; }
.s-pad-xl   { padding: 32dp; }

.s-gap-xs   { margin-bottom: 4dp; }
.s-gap-s    { margin-bottom: 8dp; }
.s-gap-m    { margin-bottom: 16dp; }
.s-gap-l    { margin-bottom: 24dp; }
.s-gap-xl   { margin-bottom: 32dp; }

/* Flex gaps, for a container rather than an item. */
.g-xs       { gap: 4dp; }
.g-s        { gap: 8dp; }
.g-m        { gap: 16dp; }
.g-l        { gap: 24dp; }
.g-xl       { gap: 32dp; }

/* --- Radius ----------------------------------------------------------------------- */

.r-s        { border-radius: 4dp; }
.r-m        { border-radius: 8dp; }
.r-l        { border-radius: 16dp; }
.r-pill     { border-radius: 999dp; }

/* --- Elevation -------------------------------------------------------------------- */

.e-1        { box-shadow: #00000059 0dp 2dp 6dp; }
.e-2        { box-shadow: #0000007f 0dp 6dp 18dp; }
.e-3        { box-shadow: #000000a5 0dp 14dp 40dp; }

/* --- Text markup ------------------------------------------------------------------ */

/*
 * What `<text>`'s markup resolves to. A style tag becomes a class of the same name, so `<angry>`
 * asks for `.angry` and this is where a game says what angry looks like.
 *
 * A starter vocabulary rather than a fixed one: rename these, add to them, and delete what a game
 * does not use. The only rule is that a tag the writers use has to have a rule somewhere, or the
 * word it marks renders as ordinary text and nobody finds out.
 *
 * `.term` is the exception worth keeping. Every table names its own class, and a name that reads
 * differently from the sentence around it is how a player learns that a place is a place.
 */

.term       { color: #61afef; }

.angry      { color: #e06c75; font-weight: bold; }
.shout      { font-weight: bold; letter-spacing: 1dp; }
.soft       { color: #a8a8b8; font-style: italic; }
.aside      { color: #8a8a99; font-size: 0.9em; }

/* --- Layout helpers --------------------------------------------------------------- */

.x-row      { display: flex; flex-direction: row; align-items: center; }
.x-col      { display: flex; flex-direction: column; }
.x-fill     { flex: 1 1 0; }
.x-center   { justify-content: center; align-items: center; }
.x-between  { justify-content: space-between; align-items: center; }
.x-truncate { white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }

/* --- Motion ----------------------------------------------------------------------- */

/*
 * Shared keyframes. Keyframes are global to a document's loaded stylesheets, so components
 * reference these by name rather than declaring their own.
 *
 * Only transform, opacity and colour appear here. Animating a layout property is the one
 * reliable way to make this slower than the UMG it replaces.
 */

@keyframes focus-breathe
{
	from { opacity: 0.55; }
	50%  { opacity: 1.0; }
	to   { opacity: 0.55; }
}

@keyframes rise-in
{
	from { opacity: 0; transform: translateY(12dp); }
	to   { opacity: 1; transform: translateY(0dp); }
}

@keyframes fade-in
{
	from { opacity: 0; }
	to   { opacity: 1; }
}

@keyframes nudge-right
{
	from { transform: translateX(0dp); }
	50%  { transform: translateX(4dp); }
	to   { transform: translateX(0dp); }
}

/* ==================================================================================== */
/* Component skins                                                                      */
/*                                                                                      */
/* Everything below dresses a class that lib/ declared the structure of. A game that     */
/* wants a different look restates these rules in its own stylesheet, loaded after this  */
/* one; it never edits the library.                                                      */
/* ==================================================================================== */

/* --- base -------------------------------------------------------------------------- */

/*
 * The root size, and the only type in this file written in dp.
 *
 * Everything else is `rem`, which resolves against this one - so the accessibility text scale can
 * move all of it by writing one property here, and a rule written in dp is a rule that setting cannot
 * reach. `uipreview --text-scale` reports those.
 */
body
{
	font-family: Inter;
	font-size: 20dp;
	line-height: 1.4;
	color: #e8e8f0;
	background-color: #14141a;

	/* The document holds focus before anything else does; without this the first direction press
	   has nowhere to go and the screen is unreachable on a controller. */
	nav: auto;
}

.focusable
{
	border-color: #ffffff00;
	/* box-shadow is not in this list because RmlUi cannot interpolate one: naming it warns and the
	   focus glow snaps rather than fading. Everything else here animates. */
	transition: background-color 0.12s cubic-out, border-color 0.12s cubic-out,
		color 0.12s cubic-out, transform 0.1s cubic-out;
}

.focusable:hover          { background-color: #363642; }
.focusable:focus-visible  { border-color: #f0c674; box-shadow: #f0c67459 0dp 0dp 12dp; }

.is-disabled              { color: #5c5c6b; opacity: 0.6; }
.is-disabled:hover        { background-color: transparent; }

.divider                  { background-color: #3a3a48; }
.divider-soft             { background-color: #2b2b36; }

/* A divider that fades out at both ends, so it reads as trim rather than a table rule. */
.divider-fade
{
	background-color: transparent;
	/* horizontal-gradient takes exactly two colours. Three needs the stop-list form. */
	decorator: linear-gradient(to right, #3a3a4800, #3a3a48, #3a3a4800);
}

/* folio.rcss gives the scrollbars their size, without which a scrolling container destroys its own
   layout. This is only what they look like. */

scrollbarvertical,
scrollbarhorizontal
{
	background-color: #0e0e13;
}

scrollbarvertical sliderbar,
scrollbarhorizontal sliderbar
{
	background-color: #3a3a48;
	border-radius: 5dp;
}

scrollbarvertical sliderbar:hover,
scrollbarhorizontal sliderbar:hover
{
	background-color: #5c5c6b;
}

/* --- button ------------------------------------------------------------------------ */

.btn
{
	background-color: #2b2b36;
	color: #e8e8f0;
	font-size: 1rem;
	line-height: 1.2;
	border-radius: 8dp;
}

.btn:focus-visible        { background-color: #363642; }

.btn-primary
{
	background-color: #f0c674;
	color: #14141a;
	font-weight: bold;
}

.btn-primary:hover        { background-color: #ffd98a; }
.btn-primary:focus-visible{ background-color: #ffd98a; border-color: #ffffff; }

.btn-danger
{
	background-color: #e06c75;
	color: #14141a;
	font-weight: bold;
}

.btn-danger:hover         { background-color: #ef8d95; }
.btn-danger:focus-visible { background-color: #ef8d95; border-color: #ffffff; }

.btn-ghost
{
	background-color: transparent;
	color: #8a8a99;
}

.btn-ghost:hover          { background-color: #2b2b36; color: #e8e8f0; }
.btn-ghost:focus-visible  { color: #e8e8f0; }

.btn-small                { font-size: 0.8rem; }

/* --- panel ----------------------------------------------------------------------- */

.panel
{
	background-color: #1f1f28;
	border-color: #3a3a48;
	border-radius: 12dp;
	box-shadow: #ff000059 0dp 6dp 18dp;
}

/* A top-lit surface. One gradient reads as a bevel without any art. */
.panel-lit
{
	decorator: vertical-gradient(#ffffff0f #ffffff00);
}

.panel-flat
{
	box-shadow: none;
	background-color: #1f1f28;
}

.panel-sunken
{
	background-color: #0e0e13;
	border-color: #2b2b36;
	box-shadow: none;
}

/* --- Regions ----------------------------------------------------------------------- */

.panel-header
{
	border-bottom-color: #3a3a48;
}

.panel-title
{
	font-size: 1.1rem;
	font-weight: bold;
	color: #e8e8f0;
}

.panel-subtitle
{
	font-size: 0.8rem;
	color: #8a8a99;
}

.panel-footer
{
	border-top-color: #3a3a48;
}

/* --- menu ------------------------------------------------------------------------ */

.menu-item
{
	background-color: transparent;
	color: #8a8a99;
	border-radius: 8dp;
}

.menu-item:hover
{
	color: #e8e8f0;
}

.menu-item:focus-visible
{
	color: #e8e8f0;
	background-color: #2b2b36;
}

/*
 * The selected item, for a menu that keeps a persistent selection rather than only a focus
 * position. Set from C++ or a data binding; it is not a focus state.
 */
.menu-item.is-selected
{
	color: #f0c674;
	background-color: #1f1f28;
}

.menu-item-label
{
	font-size: 1.1rem;
}

.menu-item-hint
{
	font-size: 0.8rem;
	color: #8a8a99;
}

/*
 * The accent wash that fades in behind a focused item.
 *
 * It has to be its own element. Decorators cannot be animated, and putting the opacity on
 * the item itself would fade the label and icon with it. So the marker is an absolutely
 * positioned child that fills the item, and the item's focus state reaches it through a
 * descendant selector - which is the only direction RCSS selectors travel. There is no
 * parent selector and no :focus-within.
 *
 *   <div class="menu-item focusable"><div class="menu-marker"/> ... </div>
 */
.menu-marker
{
	decorator: horizontal-gradient(#f0c67433 #f0c67400);
	opacity: 0;
	transition: opacity 0.15s cubic-out;
}

.menu-item:focus-visible .menu-marker
{
	opacity: 1;
}

/* --- Vertical menu with a title ---------------------------------------------------- */

.menu-title
{
	font-size: 0.65rem;
	text-transform: uppercase;
	letter-spacing: 1dp;
	color: #8a8a99;
}

/* --- list ------------------------------------------------------------------------ */

.list-row
{
	background-color: transparent;
	color: #e8e8f0;
	border-radius: 6dp;
}

.list-row:focus-visible
{
	background-color: #2b2b36;
}

/* Zebra striping, so a long list stays readable without a border per row. */
.list-striped .list-row:nth-child(even)
{
	background-color: #1f1f2880;
}

.list-row.is-selected
{
	background-color: #1f1f28;
	color: #f0c674;
}

.list-cell-num
{
	font-weight: bold;
	letter-spacing: 0.5dp;
}

.list-cell-muted
{
	color: #8a8a99;
}

/* --- Structure --------------------------------------------------------------------- */

.list-header
{
	font-size: 0.65rem;
	text-transform: uppercase;
	letter-spacing: 1dp;
	color: #8a8a99;
	border-bottom-color: #2b2b36;
}

/* Shown in place of the rows when a data-bound list is empty. Screens forget this case and
   it is the one a player is most likely to hit first. */
.list-empty
{
	color: #8a8a99;
	font-size: 0.9rem;
}

.list-scroll-fade
{
	decorator: vertical-gradient(#14141a00 #14141a);
}

/* --- slider ---------------------------------------------------------------------- */

.setting
{
	border-radius: 8dp;
}

/*
 * A fixed label column, so every control in a list of settings starts at the same x.
 *
 * This is a navigation requirement, not a cosmetic one. The spatial heuristic penalises
 * cross-axis distance about ten thousand times more heavily than distance along the
 * direction, and only when the target falls outside the source's projected area. Letting the
 * label grow and the controls sit flush right lines up their right edges and scatters their
 * left ones, so a narrow control below a wide one is outside its projection and loses to
 * something much further away that happens to overlap. Observed: a slider between a radio
 * group and a toggle was skipped entirely by pressing down. Sharing a left edge makes every
 * control overlap the one above it, and the nearest one below simply wins.
 */
.setting-label
{
	font-size: 1rem;
	color: #e8e8f0;
}

.setting-hint
{
	font-size: 0.8rem;
	color: #8a8a99;
}

/* Fixed width so the row does not reflow as the number changes width. */
.setting-value
{
	font-weight: bold;
	color: #f0c674;
}

.slider slidertrack
{
	background-color: #0e0e13;
	border-radius: 3dp;
}

.slider sliderbar
{
	background-color: #8a8a99;
	border-radius: 10dp;
	border-color: #14141a;
	transition: background-color 0.12s cubic-out, transform 0.1s cubic-out;
}

.slider sliderbar:hover
{
	background-color: #e8e8f0;
}

.slider:focus-visible sliderbar
{
	background-color: #f0c674;
	box-shadow: #f0c67459 0dp 0dp 10dp;
}

/* --- Filled variant ---------------------------------------------------------------- */

/*
 * The portion left of the thumb, filled. RmlUi's slider does not expose a fill element, so
 * this is a gradient on the track. It reads as a level meter rather than an exact fill and
 * is honest about that; use the progress element when the value must be legible from the
 * bar alone.
 */
.slider-filled slidertrack
{
	decorator: horizontal-gradient(#f0c67466 #0e0e13);
}

/* --- Progress bar ------------------------------------------------------------------ */

/*
 * <progress class="bar" value="0.4" max="1"/> is a real element and fills accurately. Use
 * it for anything read-only: health, loading, XP.
 */
.bar
{
	background-color: #0e0e13;
	border-radius: 6dp;
}

.bar fill
{
	background-color: #f0c674;
	border-radius: 6dp;
}

.bar-danger fill
{
	background-color: #e06c75;
}

.bar-success fill
{
	background-color: #98c379;
}

.bar-thin
{
	border-radius: 3dp;
}

.bar-thin fill
{
	border-radius: 3dp;
}

/* --- toggle ---------------------------------------------------------------------- */

.toggle
{
	background-color: #0e0e13;
	border-color: #3a3a48;
	border-radius: 16dp;
	decorator: linear-gradient(to right, #8a8a99, #8a8a9900 45%);
	transition: background-color 0.15s cubic-out, border-color 0.15s cubic-out,
		transform 0.1s cubic-out;
}

.toggle:hover
{
	border-color: #5c5c6b;
}

.toggle:checked
{
	background-color: #1f1f28;
	border-color: #f0c674;
	decorator: linear-gradient(to right, #f0c67400 55%, #f0c674);
}

.toggle:focus-visible
{
	border-color: #f0c674;
}

/* --- Checkbox variant -------------------------------------------------------------- */

/* A square box with a tick, for lists of options rather than on/off settings. */
.check
{
	background-color: #0e0e13;
	border-color: #3a3a48;
	border-radius: 6dp;
	transition: background-color 0.12s cubic-out, border-color 0.12s cubic-out;
}

.check:checked
{
	background-color: #f0c674;
	border-color: #f0c674;
}

.check:focus-visible
{
	border-color: #f0c674;
}

.radio
{
	background-color: #0e0e13;
	border-color: #3a3a48;
	border-radius: 11dp;
	transition: background-color 0.12s cubic-out, border-color 0.12s cubic-out;
}

.radio:hover
{
	border-color: #5c5c6b;
}

.radio:checked
{
	background-color: #f0c674;
	border-color: #f0c674;
}

.radio:focus-visible
{
	border-color: #f0c674;
}

.radio-label
{
	color: #8a8a99;
	font-size: 0.9rem;
	transition: color 0.12s cubic-out;
}

.radio:checked + .radio-label
{
	color: #e8e8f0;
}

.radio:focus-visible + .radio-label
{
	color: #f0c674;
}

/* --- Segmented control ------------------------------------------------------------- */

/*
 *   <div class="segmented">
 *     <div class="segment">
 *       <input type="radio" class="segment-hit" name="difficulty" id="d_calm" checked/>
 *       <span class="segment-text" data-loc="calm">Calm</span>
 *     </div>
 *     ...
 *   </div>
 *
 * A real radio set, so RmlUi owns the state: clicking or confirming actually changes the
 * selection, with no C++ and no data binding. An input renders no text of its own, so each
 * segment is a caption with a full-size input behind it. The input is what takes focus, what
 * gets clicked, and what carries the selected fill; the caption sits on top of it with
 * pointer-events: none so hit testing falls through, and picks up its colour through the
 * adjacent sibling combinator.
 *
 * The alternative - a plain div with an .is-selected class - looks identical and does
 * nothing at all until something external swaps the class, which makes it untestable in the
 * preview. Bind the checked state with data-checked when the value lives in game settings.
 */
.segmented
{
	background-color: #0e0e13;
	border-radius: 8dp;
}

.segment-hit
{
	background-color: transparent;
	border-color: #ffffff00;
	border-radius: 6dp;
	transition: background-color 0.12s cubic-out, border-color 0.12s cubic-out;
}

.segment-hit:hover
{
	background-color: #1f1f28;
}

.segment-hit:checked
{
	background-color: #f0c674;
}

.segment-hit:focus-visible
{
	border-color: #f0c674;
}

.segment-hit:checked:focus-visible
{
	border-color: #ffffff;
}

.segment-text
{
	color: #8a8a99;
	font-size: 0.9rem;
	transition: color 0.12s cubic-out;
}

.segment-hit:hover + .segment-text
{
	color: #e8e8f0;
}

.segment-hit:checked + .segment-text
{
	color: #14141a;
	font-weight: bold;
}

/* --- tabbar ---------------------------------------------------------------------- */

/*
 * :first-of-type is not decoration. A tabset creates a `tabs` or `panels` child on demand
 * whenever it looks for one and does not find it, and during parsing it looks before the
 * markup's own are in place - so a tabset that declares both still ends up with a spare
 * empty pair appended after them. A bare `tabs` selector therefore styles two elements, and
 * the empty one draws this border again at the bottom of the tabset as a stray hairline.
 */
.tabs tabs:first-of-type
{
	border-bottom-color: #2b2b36;
}

.tab
{
	background-color: transparent;
	color: #8a8a99;
	font-size: 1rem;
	border-top-left-radius: 8dp;
	border-top-right-radius: 8dp;
	border-bottom-color: #ffffff00;
	transition: background-color 0.12s cubic-out, color 0.12s cubic-out,
		border-bottom-color 0.15s cubic-out;
}

.tab:hover
{
	color: #e8e8f0;
	background-color: #1f1f28;
}

.tab:selected
{
	color: #f0c674;
	border-bottom-color: #f0c674;
}

.tab:focus-visible
{
	color: #e8e8f0;
	background-color: #2b2b36;
	border-bottom-color: #f0c674;
}

/* The dot that marks a tab with unsaved or unseen content. */
.tab-badge
{
	background-color: #e06c75;
	border-radius: 4dp;
}

/* --- Shoulder hints ---------------------------------------------------------------- */

/*
 * The LB/RB affordance beside the bar. Sprite names only, never file paths: an undeclared
 * name renders as a labelled placeholder and lands in ASSETS_WANTED.md instead of failing
 * quietly, which is what lets this screen exist before its art does.
 */
.tab-shoulder
{
	color: #8a8a99;
	font-size: 0.8rem;
}

/* --- modal ----------------------------------------------------------------------- */

.modal-scrim
{
	background-color: #0a0a0ec2;
}

/* Blurs the screen behind the dialog. Preview-only until the engine renderer implements
   backdrop filters; it degrades to nothing rather than to something wrong. */
.modal-scrim-blur
{
	backdrop-filter: blur(6dp);
}

.modal
{
	background-color: #1f1f28;
	border-color: #3a3a48;
	border-radius: 12dp;
	box-shadow: #000000a5 0dp 14dp 40dp;
}

/* --- Regions ----------------------------------------------------------------------- */

.modal-title
{
	font-size: 1.2rem;
	font-weight: bold;
	color: #e8e8f0;
}

.modal-body
{
	color: #8a8a99;
	font-size: 0.9rem;
	line-height: 1.5;
}

.modal-actions
{
	background-color: #14141a;
	border-top-color: #2b2b36;
}

/* --- Severity ---------------------------------------------------------------------- */

.modal-danger
{
	border-color: #e06c75;
}

.modal-danger .modal-title
{
	color: #e06c75;
}

.toast-body
{
	background-color: #2b2b36;
	color: #e8e8f0;
	font-size: 0.9rem;
	border-radius: 999dp;
	box-shadow: #0000007f 0dp 6dp 18dp;
}

/* ==================================================================================== */
/* Themes                                                                               */
/*                                                                                      */
/* A theme is a media query, not a swapped value: RCSS has no custom properties, so the  */
/* only way a stylesheet carries two looks is to write both and let one win. Turn one on */
/* with folio.Theme, or Set Theme from Blueprint. Several can be on at once.             */
/*                                                                                      */
/* Rules inside a theme block override by being later in the same file, so a theme need  */
/* only restate what it disagrees with.                                                  */
/* ==================================================================================== */

/*
 * High contrast, which is an accessibility setting rather than a taste one.
 *
 * Deliberately not just "brighter": the focus ring gains width as well as contrast, because the
 * players who need this are often the ones a 2dp ring is invisible to, and disabled controls stop
 * relying on opacity alone, which reads as nothing at all against a dark background.
 */
@media (theme: high-contrast)
{
	body                      { color: #ffffff; background-color: #000000; }

	.c-text                   { color: #ffffff; }
	.c-muted                  { color: #d0d0d8; }
	.c-dim                    { color: #b0b0bc; }
	.c-surface                { background-color: #101018; }
	.c-raised                 { background-color: #1c1c28; }

	.focusable                { border-width: 3dp; }
	.focusable:focus-visible  { border-color: #ffffff; box-shadow: #ffffffa0 0dp 0dp 14dp; }
	.focusable:hover          { background-color: #303040; }

	.is-disabled              { color: #9090a0; opacity: 1.0; }

	.btn                      { background-color: #1c1c28; color: #ffffff; }
	.btn-primary              { background-color: #ffd98a; color: #000000; }
	.btn-danger               { background-color: #ff9aa2; color: #000000; }
	.btn-ghost                { color: #d0d0d8; }

	.divider                  { background-color: #7a7a8a; }

	.panel                    { border-color: #7a7a8a; }
}

/* --- prompt ---------------------------------------------------------------------- */

/*
 * Drawn glyphs, so a project gets working prompts with no art at all. Ink on light, which reads on
 * the dark surfaces the rest of this theme uses and stays legible over a scene.
 */

.prompt { color: #e8e8f0; font-size: 0.85rem; }

.prompt .pg-label { color: #c8c8d4; font-size: 0.85rem; }

/*
 * Every glyph is drawn in ems of this one size, so the whole set scales together and follows the
 * accessibility text scale like any other type. A cap that stayed put while its label grew would be
 * the one thing on the screen the setting could not reach.
 */
.pg { font-size: 0.75rem; }

.pg-key, .pg-face, .pg-bumper, .pg-trigger, .pg-unbound {
	background-color: #e8e8f0;
	border-color: #0c0c12;
	color: #14141c;
	font-weight: 700;
}

/* The skirt, which is what makes a cap look pressable rather than printed. */
.pg-key { border-bottom-color: #8d8da0; }


/* The dash is text, so it is held to the same 4.5:1 as any other text - the border it sits in can be
   dimmer than the glyph, and is. */
.pg-unbound { background-color: #00000000; border-color: #6a6a7a; color: #8a8a99; }

.pg-mouse .body { background-color: #e8e8f0; border-color: #0c0c12; }
.pg-mouse .lmb, .pg-mouse .rmb, .pg-mouse .side { background-color: #00000000; }
.pg-mouse .seam, .pg-mouse .rail { background-color: #0c0c12; }
.pg-mouse .wheel { background-color: #e8e8f0; border-color: #0c0c12; }

/* The button the prompt is about, filled in the accent so it reads at a glance. */
.pg-mouse.left .lmb    { background-color: #f0c674; }
.pg-mouse.right .rmb   { background-color: #f0c674; }
.pg-mouse.middle .wheel { background-color: #f0c674; }
.pg-mouse.wheel .wheel  { background-color: #f0c674; }
.pg-mouse.side-one .side { background-color: #f0c674; }
.pg-mouse.side-two .side.two { background-color: #f0c674; }

.pg-face .mark u { background-color: #14141c; border-color: #14141c; }

/* PlayStation's marks carry their own colours; a platform that does not want them restates these. */
.pg-cross .mark u    { background-color: #7aa7ff; }
.pg-circle .mark u   { border-color: #ff6f6f; }
.pg-square .mark u   { border-color: #f08cd0; }
.pg-triangle .mark u { background-color: #56d6a0; }

.pg-stick .base { background-color: #e8e8f0; border-color: #0c0c12; }
.pg-stick .top  { background-color: #8d8da0; }
.pg-stick.pressed .top { background-color: #f0c674; }

.pg-dpad u { background-color: #e8e8f0; border-color: #0c0c12; }
.pg-dpad u.on { background-color: #f0c674; }

/*
 * The prompt glyphs under high contrast.
 *
 * After the prompt rules rather than in the theme block above, because a theme in RCSS is a later
 * rule rather than a swapped value: written up there it would lose to every rule below it.
 */
@media (theme: high-contrast)
{
	.prompt { color: #ffffff; }
	.prompt .pg-label { color: #e0e0ea; }

	.pg-key, .pg-face, .pg-bumper, .pg-trigger { background-color: #ffffff; color: #000000; }
	.pg-unbound { border-color: #c6c6d2; color: #c6c6d2; }
}
